---
import { Font } from 'astro:assets';
import { getLocalePath, type Locale } from '../i18n/config';
import { createProfileSchema, type SchemaNode } from '../data/schema';
import '../styles/global.css';

interface AlternateUrls {
	es: URL;
	en: URL;
	xDefault?: URL;
}

interface Props {
	locale: Locale;
	title: string;
	description?: string;
	robots?: string;
	canonical?: URL;
	includeAlternates?: boolean;
	alternateUrls?: AlternateUrls;
	structuredData?: readonly SchemaNode[];
	ogType?: 'website' | 'article';
}

const {
	locale,
	title,
	description,
	robots,
	canonical,
	includeAlternates = false,
	alternateUrls,
	structuredData,
	ogType = 'website',
} = Astro.props;

const socialImage = new URL('/og/portafolio-og.png', Astro.site ?? Astro.url);
const socialImageAlt =
	locale === 'es'
		? 'Josué Correa Quispe, Desarrollador Backend especializado en Laravel, PHP, MySQL y APIs REST'
		: 'Josué Correa Quispe, Backend Developer specialized in Laravel, PHP, MySQL and REST APIs';
const siteUrl = new URL('/', Astro.site ?? Astro.url);
const profileUrl = canonical ?? new URL(getLocalePath(locale), siteUrl);
const resolvedAlternates = alternateUrls ?? (includeAlternates
	? {
			es: new URL('/', siteUrl),
			en: new URL('/en/', siteUrl),
			xDefault: new URL('/', siteUrl),
		}
	: undefined);
const schemaGraph = structuredData ?? createProfileSchema({
	locale,
	siteUrl,
	pageUrl: profileUrl,
	title,
	description,
	socialImage,
	socialImageAlt,
});
const schema = {
	'@context': 'https://schema.org',
	'@graph': schemaGraph,
};
const schemaJson = JSON.stringify(schema).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={locale} data-theme="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#09090b" />
		{description && <meta name="description" content={description} />}
		<meta name="robots" content={robots ?? 'index, follow, max-image-preview:large'} />

		<script is:inline>
			(() => {
				let theme;

				try {
					theme = localStorage.getItem('theme');
				} catch {
					theme = null;
				}

				if (theme !== 'light' && theme !== 'dark') {
					theme = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
				}

				document.documentElement.dataset.theme = theme;
				document
					.querySelector('meta[name="theme-color"]')
					?.setAttribute('content', theme === 'dark' ? '#09090b' : '#f4f4f5');

				const canAnimateMotion =
					'animate' in Element.prototype &&
					'requestAnimationFrame' in window &&
					!window.matchMedia('(prefers-reduced-motion: reduce)').matches;

				if (canAnimateMotion) {
					document.documentElement.dataset.textAnimations = 'enabled';
					document.documentElement.dataset.revealAnimations = 'enabled';
				}
			})();
		</script>

		<script is:inline>
			// Page-to-page view transitions (opted in by @view-transition in global.css). The project
			// title that leads to the next page travels into that page's title. pagereveal fires before
			// the first render, so this has to run from the head.
			(() => {
				let clickedHref = null;

				const markTitle = (title) => {
					document.querySelectorAll('[data-vt-title]').forEach((marked) => {
						delete marked.dataset.vtTitle;
					});

					if (!title) return null;

					// A title off screen or tucked under the sticky header would fly in over everything;
					// let it fade with the page instead.
					const box = title.getBoundingClientRect();
					const header = document.querySelector('[data-site-header]');
					const top = header ? header.getBoundingClientRect().bottom : 0;
					if (box.top < top || box.top >= window.innerHeight) return null;

					title.dataset.vtTitle = '';
					return title;
				};

				const titleFor = (url) => {
					if (!url) return null;
					const { pathname } = new URL(url, window.location.href);
					return document.querySelector('[data-project-path="' + pathname + '"]');
				};

				const pageTitle = () => document.querySelector('h1[data-project-path]');

				// Browsers without the Navigation API only know the destination from the clicked link.
				if (!window.navigation) {
					document.addEventListener(
						'click',
						(event) => {
							const link = event.target instanceof Element ? event.target.closest('a[href]') : null;
							clickedHref = link ? link.href : null;
						},
						true,
					);
				}

				// The browser skips a transition when the tab is hidden, the next page is slow, or another
				// navigation interrupts it; the page still loads, so the rejection needs no handling.
				const ignoreSkip = (transition) => transition.ready.catch(() => {});

				window.addEventListener('pageswap', (event) => {
					if (!event.viewTransition) return;

					ignoreSkip(event.viewTransition);
					const destination = event.activation ? event.activation.entry.url : clickedHref;
					markTitle(titleFor(destination) ?? pageTitle());
				});

				window.addEventListener('pagereveal', (event) => {
					// A page restored from the back/forward cache may still carry the mark it left with.
					markTitle(null);

					if (!event.viewTransition) return;

					ignoreSkip(event.viewTransition);
					const activation = window.navigation ? window.navigation.activation : null;
					const origin = activation && activation.from ? activation.from.url : document.referrer;
					const title = markTitle(pageTitle() ?? titleFor(origin));

					// The title lands already in place; its text reveal would only hide it from the transition.
					if (title && title.hasAttribute('data-animate-text')) {
						title.dataset.textAnimationState = 'complete';
					}

					const clear = () => markTitle(null);
					event.viewTransition.finished.then(clear, clear);
				});
			})();
		</script>

		{description && <meta property="og:type" content={ogType} />}
		{description && <meta property="og:title" content={title} />}
		{description && <meta property="og:description" content={description} />}
		{description && <meta property="og:locale" content={locale === 'es' ? 'es_PE' : 'en_US'} />}
		{description && <meta property="og:locale:alternate" content={locale === 'es' ? 'en_US' : 'es_PE'} />}
		{description && canonical && <meta property="og:url" content={canonical} />}
		{description && <meta property="og:site_name" content="Josué Correa" />}
		{description && <meta property="og:image" content={socialImage} />}
		{description && <meta property="og:image:secure_url" content={socialImage} />}
		{description && <meta property="og:image:type" content="image/png" />}
		{description && <meta property="og:image:width" content="1200" />}
		{description && <meta property="og:image:height" content="630" />}
		{description && <meta property="og:image:alt" content={socialImageAlt} />}

		{description && <meta name="twitter:card" content="summary_large_image" />}
		{description && <meta name="twitter:site" content="@josuecorreaqu" />}
		{description && <meta name="twitter:creator" content="@josuecorreaqu" />}
		{description && <meta name="twitter:title" content={title} />}
		{description && <meta name="twitter:description" content={description} />}
		{description && <meta name="twitter:image" content={socialImage} />}
		{description && <meta name="twitter:image:alt" content={socialImageAlt} />}

		{canonical && <link rel="canonical" href={canonical} />}
		{resolvedAlternates && <link rel="alternate" hreflang="es" href={resolvedAlternates.es} />}
		{resolvedAlternates && <link rel="alternate" hreflang="en" href={resolvedAlternates.en} />}
		{resolvedAlternates && <link rel="alternate" hreflang="x-default" href={resolvedAlternates.xDefault ?? resolvedAlternates.es} />}

		<link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
		<link rel="icon" type="image/svg+xml" href="/logo.svg" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<Font cssVariable="--font-tasa-orbiter" preload />
		<Font cssVariable="--font-geist-mono" preload />
		<title>{title}</title>
		{description && <script is:inline type="application/ld+json" set:html={schemaJson} />}
		{import.meta.env.PROD && (
			<script
				is:inline
				type="module"
				src="https://static.cloudflareinsights.com/beacon.min.js"
				data-cf-beacon='{"token": "e390e14adb004a51af90bed96ad385aa"}'
			></script>
		)}
		<slot name="head" />
	</head>
	<body>
		<slot />
	</body>
</html>