---
import ProjectCaseStudy from '../../components/projects/ProjectCaseStudy.astro';
import { getProjectStaticPaths, type Project } from '../../data/projects';
import ProjectLayout from '../../layouts/ProjectLayout.astro';

export const getStaticPaths = () => getProjectStaticPaths('es');

interface Props {
	project: Project;
}

const { project } = Astro.props;
---

<ProjectLayout locale="es" project={project}>
	<ProjectCaseStudy locale="es" project={project} />
</ProjectLayout>
