---
import NotesIndex from '../../../components/notes/NotesIndex.astro';
import { getNotes, getNotesFeedPath, notesPaths } from '../../../data/notes';
import { createNotesIndexSchema } from '../../../data/schema';
import { useTranslations } from '../../../i18n/translations';
import PageLayout from '../../../layouts/PageLayout.astro';

const t = useTranslations('en').notes;
const siteUrl = new URL('/', Astro.site ?? Astro.url);
const notes = await getNotes('en');
const otherNotes = await getNotes('es');
const hasOwnNotes = notes.length > 0;
const structuredData = createNotesIndexSchema({
	locale: 'en',
	siteUrl,
	pageUrl: new URL(notesPaths.en, siteUrl),
	title: t.meta.title,
	description: t.meta.description,
	label: t.label,
	notes,
});
---

{/* An index with nothing to list stays out of search results and claims no translation. */}
<PageLayout
	locale="en"
	title={t.meta.title}
	description={t.meta.description}
	path={notesPaths.en}
	alternatePath={notesPaths.es}
	structuredData={structuredData}
	currentSection="notas"
	robots={hasOwnNotes ? undefined : 'noindex, follow'}
	hreflang={hasOwnNotes && otherNotes.length > 0}
	feed={hasOwnNotes ? { path: getNotesFeedPath('en'), title: t.feedTitle } : undefined}
>
	<NotesIndex
		locale="en"
		notes={notes}
		alternateIndexPath={otherNotes.length > 0 ? notesPaths.es : undefined}
	/>
</PageLayout>
