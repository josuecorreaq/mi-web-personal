---
import PrivacyPage from '../../../components/privacy/PrivacyPage.astro';
import { createPrivacySchema } from '../../../data/schema';
import { PRIVACY_LAST_MODIFIED, PRIVACY_PUBLISHED, privacyPaths } from '../../../data/privacy';
import { useTranslations } from '../../../i18n/translations';
import PageLayout from '../../../layouts/PageLayout.astro';

const t = useTranslations('en').privacy;
const siteUrl = new URL('/', Astro.site ?? Astro.url);
const structuredData = createPrivacySchema({
	locale: 'en',
	siteUrl,
	pageUrl: new URL(privacyPaths.en, siteUrl),
	title: t.meta.title,
	description: t.meta.description,
	label: t.label,
	datePublished: PRIVACY_PUBLISHED,
	dateModified: PRIVACY_LAST_MODIFIED,
});
---

<PageLayout
	locale="en"
	title={t.meta.title}
	description={t.meta.description}
	path={privacyPaths.en}
	alternatePath={privacyPaths.es}
	structuredData={structuredData}
>
	<PrivacyPage locale="en" />
</PageLayout>
