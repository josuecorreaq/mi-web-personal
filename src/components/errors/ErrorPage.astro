---
import Icon from '../common/Icon.astro';
import type { Locale } from '../../i18n/config';

interface Props {
	locale: Locale;
	status: string;
	title: string;
	description: string;
	actionLabel: string;
	projectsLabel: string;
	homePath: string;
}

const { locale, status, title, description, actionLabel, projectsLabel, homePath } = Astro.props;
---

<main lang={locale} class="page-shell flex flex-1 flex-col justify-center py-section">
	<div class="flex flex-wrap items-center justify-between gap-x-20 gap-y-10">
		<div class="min-w-0 flex-[1_1_32rem]">
			<p class="font-mono text-[0.8125rem] text-muted">Error {status}</p>
			<h1 class="ml-(--optical-inset) mt-4.5 max-w-[14em] text-balance font-display text-[clamp(2.25rem,5vw,4.25rem)] font-heading leading-[1.06] tracking-[-0.03em]">
				{title}
			</h1>
			<p class="ml-(--optical-inset) mt-[clamp(0.75rem,2vw,1.25rem)] max-w-[22em] text-pretty font-display text-[clamp(1.375rem,2.6vw,2rem)] font-heading leading-[1.2] tracking-[-0.02em] text-muted">
				{description}
			</p>

			<div class="mt-block flex flex-wrap items-center gap-x-6 gap-y-3">
				<a
					href={homePath}
					class="inline-flex min-h-12 items-center gap-2.5 border border-brand-edge bg-brand px-5.5 font-mono text-sm font-semibold text-on-brand transition-[background-color,translate] hover:bg-brand-hover active:translate-y-px"
				>
					{actionLabel}
					<Icon name="arrow-right" class="size-4 shrink-0" />
				</a>
				<a
					href={`${homePath}#proyectos`}
					class="inline-flex min-h-12 items-center gap-2 font-mono text-sm font-semibold text-ink underline decoration-line decoration-1 underline-offset-[6px] transition-colors hover:text-accent hover:decoration-accent"
				>
					{projectsLabel}
					<Icon name="arrow-right" class="size-4 shrink-0" />
				</a>
			</div>
		</div>

		<p
			class="hidden font-display text-[clamp(5rem,13vw,9.5rem)] font-heading leading-[0.85] tracking-[-0.04em] text-muted/35 tabular-nums lg:block"
			aria-hidden="true"
		>
			{status}
		</p>
	</div>
</main>
