---
import ArrowLeft from '@lucide/astro/icons/arrow-left';
import { render } from 'astro:content';
import ContactBand from '../common/ContactBand.astro';
import LinkRow from '../common/LinkRow.astro';
import MetaList from '../common/MetaList.astro';
import { formatNoteDate, notesPaths, type Note } from '../../data/notes';
import { getProjectById } from '../../data/projects';
import { getLocalePath, type Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/translations';

interface Props {
	locale: Locale;
	note: Note;
}

const { locale, note } = Astro.props;
const t = useTranslations(locale).notes;
const { Content } = await render(note.entry);
const project = note.project ? getProjectById(locale, note.project) : undefined;
const meta = [
	{ text: `${t.published} ${formatNoteDate(locale, note.datePublished)}`, datetime: note.datePublished },
	...(note.dateModified !== note.datePublished
		? [{ text: `${t.updated} ${formatNoteDate(locale, note.dateModified)}`, datetime: note.dateModified }]
		: []),
	`${note.readingMinutes} ${t.minutesRead}`,
	// Drafts only reach the dev server; the mark keeps one from passing for a published note there.
	...(note.entry.data.draft ? [locale === 'es' ? 'Borrador' : 'Draft'] : []),
];
---

<article>
	<header class="page-shell pb-section pt-[clamp(1.5rem,4vw,3rem)]">
		<a
			href={notesPaths[locale]}
			class="group inline-flex min-h-11 items-center gap-2 font-mono text-[0.8125rem] text-muted transition-colors hover:text-accent"
		>
			<ArrowLeft class="size-4 transition-transform duration-200 group-hover:-translate-x-[3px]" aria-hidden="true" stroke-width={1.8} />
			{t.back}
		</a>

		<MetaList items={meta} class="mt-block font-mono text-[0.8125rem] text-muted" />
		<h1 class="ml-(--optical-inset) mt-4.5 max-w-[18em] text-balance type-page-title" data-animate-text="words">
			{note.title}
		</h1>
		<p
			class="mt-[clamp(0.75rem,2vw,1.25rem)] max-w-[32em] text-pretty type-lead text-muted"
			data-animate-reveal="up"
			data-animate-reveal-delay="200"
		>
			{note.description}
		</p>
	</header>

	<div class="page-shell border-t border-line py-section">
		<div class="note-prose">
			<Content />
		</div>
	</div>

	{project && (
		<nav class="page-shell border-t border-line py-section" aria-label={t.relatedProject}>
			<LinkRow
				href={project.path}
				eyebrow={t.relatedProject}
				title={project.name}
				description={project.objective}
				projectPath={project.path}
				class="border-y border-line"
			/>
		</nav>
	)}

	<ContactBand
		id="note-contact"
		title={t.contact}
		copy={t.contactCopy}
		action={t.contactAction}
		href={`${getLocalePath(locale)}#contacto`}
	/>
</article>

<style>
	/* The rendered Markdown carries no classes, so the prose is styled from its container. It reads at
	   the same size and measure as the case studies' rows; code, tables and figures may run wider. */
	.note-prose {
		--prose-measure: 43rem;

		color: var(--color-muted);
		font-size: 1.125rem;
		line-height: 1.7;
	}

	.note-prose > :global(*) {
		max-width: var(--prose-measure);
	}

	.note-prose > :global(* + *) {
		margin-top: 1.25em;
	}

	/* Figures style themselves, so the element rules below skip whatever sits inside one. */
	.note-prose > :global(figure) {
		max-width: 52rem;
	}

	.note-prose > :global(* + figure),
	.note-prose > :global(figure + *) {
		margin-top: 2em;
	}

	.note-prose :global(:is(p, li, blockquote)) {
		text-wrap: pretty;
	}

	.note-prose :global(:is(h2, h3)) {
		scroll-margin-top: 6rem;
		color: var(--color-ink);
		font-family: var(--font-display);
		font-weight: var(--font-weight-heading);
		text-wrap: balance;
	}

	.note-prose :global(h2) {
		margin-top: 2.25em;
		font-size: clamp(1.5rem, 2.4vw, 1.875rem);
		line-height: 1.15;
		letter-spacing: -0.02em;
	}

	.note-prose :global(h3) {
		margin-top: 2em;
		font-size: 1.25rem;
		line-height: 1.3;
		letter-spacing: -0.01em;
	}

	.note-prose > :global(:is(h2, h3) + *) {
		margin-top: 0.75em;
	}

	.note-prose :global(strong) {
		color: var(--color-ink);
		font-weight: 600;
	}

	/* Links underline in the rule color and turn to the accent on hover, like the site's text links. */
	.note-prose :global(a) {
		color: var(--color-ink);
		text-decoration: underline;
		text-decoration-color: var(--color-line);
		text-decoration-thickness: 1px;
		text-underline-offset: 0.25em;
		transition:
			color 160ms ease,
			text-decoration-color 160ms ease;
	}

	@media (hover: hover) {
		.note-prose :global(a:hover) {
			color: var(--color-accent);
			text-decoration-color: var(--color-brand);
		}
	}

	/* Unordered items carry the same small square as BulletList. */
	.note-prose :global(ul:not(figure *)) {
		list-style: none;
		padding-left: 0;
	}

	.note-prose :global(ul:not(figure *) > li) {
		position: relative;
		padding-left: 1.4em;
	}

	.note-prose :global(ul:not(figure *) > li)::before {
		position: absolute;
		top: 0.7em;
		left: 0.15em;
		width: 5px;
		height: 5px;
		background: var(--color-accent);
		content: '';
	}

	.note-prose :global(ol:not(figure *)) {
		padding-left: 1.4em;
		list-style: decimal;
	}

	.note-prose :global(ol:not(figure *) > li)::marker {
		color: var(--color-muted);
		font-family: var(--font-mono);
		font-size: 0.875em;
	}

	.note-prose :global(li:not(figure *) + li) {
		margin-top: 0.5em;
	}

	.note-prose :global(blockquote) {
		border-left: 2px solid var(--color-line);
		padding-left: 1.25em;
	}

	.note-prose :global(hr) {
		border: 0;
		border-top: 1px solid var(--color-line);
	}

	.note-prose :global(:not(pre) > code:not(figure *)) {
		border: 1px solid var(--color-line);
		background: var(--color-surface);
		padding: 0.05em 0.35em;
		color: var(--color-ink);
		font-family: var(--font-mono);
		font-size: 0.85em;
		overflow-wrap: anywhere;
	}

	.note-prose :global(pre:not(figure *)) {
		max-width: 52rem;
		overflow-x: auto;
		border: 1px solid var(--color-line);
		background: var(--color-surface);
		padding: 1rem 1.25rem;
		color: var(--color-ink);
		font-family: var(--font-mono);
		font-size: 0.875rem;
		line-height: 1.65;
		tab-size: 4;
	}

	.note-prose :global(table) {
		display: block;
		max-width: 52rem;
		overflow-x: auto;
		border-collapse: collapse;
		font-size: 1rem;
	}

	.note-prose :global(:is(th, td)) {
		border-bottom: 1px solid var(--color-line);
		padding: 0.6em 1.25em 0.6em 0;
		text-align: left;
		vertical-align: top;
	}

	.note-prose :global(th) {
		color: var(--color-ink);
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		font-weight: 500;
	}

	.note-prose :global(img:not(figure *)) {
		max-width: 100%;
		height: auto;
		border: 1px solid var(--color-line);
	}

	/* Prism tokens. One accent only, so the code stays in ink and steps down to muted for what the eye
	   skips (comments, punctuation); keywords stand out by weight, not by color. */
	.note-prose :global(.token:is(.comment, .prolog, .doctype, .cdata)) {
		color: var(--color-muted);
		font-style: italic;
	}

	.note-prose :global(.token:is(.punctuation, .operator)) {
		color: var(--color-muted);
	}

	.note-prose :global(.token:is(.keyword, .important, .atrule, .boolean)) {
		font-weight: 600;
	}
</style>
