---
import { figureBar } from '../../../styles/classes';
import type { Locale } from '../../../i18n/config';
import { getProjectById } from '../../../data/projects';

interface Props {
	locale?: Locale;
}

const { locale = 'es' } = Astro.props;

// The figures carry their own copy, so a note's translation only has to pass its locale.
const copy = {
	es: {
		bar: 'Estructura de app/',
		span: 'poco más de 5 semanas',
		before: 'Antes: por tipo técnico',
		beforeExtra: 'más controllers y form requests',
		after: 'Después: por dominio',
		modules: 'Nueve módulos, cada uno con las capas Http, Application, Domain e Infrastructure.',
		module: 'Módulo',
		layersLabel: 'Capas de cada módulo',
		shared: '19 clases comunes',
		hint: 'Selecciona una capa para verla en cada módulo.',
		caption:
			'Las cuatro carpetas por tipo técnico ya no existen. Su código pasó a nueve módulos de dominio que repiten las mismas cuatro capas, y lo que comparten dos o más módulos quedó en Shared.',
	},
	en: {
		bar: 'Structure of app/',
		span: 'just over 5 weeks',
		before: 'Before: by technical type',
		beforeExtra: 'plus controllers and form requests',
		after: 'After: by domain',
		modules: 'Nine modules, each with the Http, Application, Domain and Infrastructure layers.',
		module: 'Module',
		layersLabel: 'Layers of each module',
		shared: '19 shared classes',
		hint: 'Select a layer to see it in every module.',
		caption:
			'The four folders by technical type are gone. Their code moved into nine domain modules that repeat the same four layers, and what two or more modules share lives in Shared.',
	},
}[locale];

// The layers and their rules are the case study's, so both figures always tell the same story.
const project = getProjectById(locale, 'credit-management-platform');
const layers = project?.architecture.layers ?? [];
const coreLayer = project?.coreLayer ?? -1;

const folders = [
	{ name: 'Models/', count: 45 },
	{ name: 'Services/', count: 83 },
	{ name: 'Utilities/', count: 22 },
	{ name: 'Filters/', count: 14 },
];
const modules = Array.from({ length: 9 }, (_, index) => String(index + 1).padStart(2, '0'));
const uid = `monolith-${locale}`;

// Build-up timeline in ms (see figure-sequence.ts): the old folders, the arrow, the modules one by
// one, then what they share.
const folderAt = (index: number) => index * 70;
const arrowAt = 420;
const tileAt = (index: number) => 560 + index * 55;
const legendAt = tileAt(modules.length) + 260;
const sharedAt = legendAt + 120;

const label = 'font-mono text-[0.78rem] text-muted';
const barClass = (index: number) => [
	'block h-1.5 border transition-[opacity,border-color] duration-200 ease-out-quart data-[state=dimmed]:opacity-25 motion-reduce:transition-none',
	index === coreLayer
		? 'border-brand-edge bg-brand'
		: 'border-line bg-elevated data-[state=active]:border-ink',
];
const panelClass =
	'col-start-1 row-start-1 invisible opacity-0 transition-[opacity,visibility] duration-200 ease-out-quart data-[visible=true]:visible data-[visible=true]:opacity-100 motion-reduce:transition-none';
---

<figure class="m-0 min-w-0 border border-line" data-monolith>
	<div class={figureBar}>
		<span>{copy.bar}</span>
		<span>{copy.span}</span>
	</div>

	<div class="grid items-start gap-6 p-[clamp(1rem,2.4vw,1.75rem)] md:grid-cols-[minmax(0,0.85fr)_auto_minmax(0,1.15fr)] md:gap-5">
		<div class="min-w-0">
			<p class={label}>{copy.before}</p>
			<ul class="mt-3 grid gap-2">
				{folders.map((folder, index) => (
					<li
						class="seq-rise flex items-baseline justify-between gap-4 border border-line px-3 py-2.5 font-mono text-[0.84rem] text-ink"
						data-at={folderAt(index)}
					>
						<span>{folder.name}</span>
						<span class="text-muted">{folder.count}</span>
					</li>
				))}
			</ul>
			<p class:list={[label, 'seq-rise mt-2.5']} data-at={folderAt(folders.length)}>{copy.beforeExtra}</p>
		</div>

		<span class="seq-arrow mx-auto block size-5 self-center md:mt-8" data-at={arrowAt} aria-hidden="true">
			<svg
				class="size-full rotate-90 text-field md:rotate-0"
				viewBox="0 0 20 20"
				fill="none"
				stroke="currentColor"
				stroke-width="1.25"
				stroke-linecap="square"
			>
				<path d="M2 10h15M12.5 5.5 17 10l-4.5 4.5" />
			</svg>
		</span>

		<div class="min-w-0">
			<p class={label}>{copy.after}</p>
			<p class="sr-only">{copy.modules}</p>
			<div class="mt-3 grid grid-cols-3 gap-2" aria-hidden="true">
				{modules.map((number, index) => (
					<div class="seq-pop border border-line p-2" data-tile data-at={tileAt(index)}>
						<span class="block font-mono text-[0.72rem] text-muted">{copy.module} {number}</span>
						<span class="mt-2 grid gap-1">
							{layers.map((_, layerIndex) => (
								<span class:list={['seq-bar', barClass(layerIndex)]} data-bar={layerIndex} data-state="idle"></span>
							))}
						</span>
					</div>
				))}
			</div>

			<ul
				class="seq-rise mt-2 flex flex-wrap gap-x-4 font-mono text-[0.72rem] text-muted"
				aria-label={copy.layersLabel}
				data-at={legendAt}
				data-monolith-legend
			>
				{layers.map((layer, index) => (
					<li>
						<button
							type="button"
							class="flex min-h-8 touch-manipulation items-center gap-1.5 transition-colors duration-200 hover:text-ink aria-pressed:text-ink motion-reduce:transition-none"
							data-layer={index}
							aria-pressed="false"
							aria-describedby={`${uid}-layer-${index}`}
						>
							<span class:list={[barClass(index), 'w-3']} aria-hidden="true"></span>
							{layer.name}
						</button>
					</li>
				))}
			</ul>

			<div
				class="seq-rise mt-2 flex items-baseline justify-between gap-4 border border-dashed border-field px-3 py-2.5 font-mono text-[0.84rem] text-ink"
				data-at={sharedAt}
			>
				<span>Shared/</span>
				<span class="text-muted">{copy.shared}</span>
			</div>
		</div>
	</div>

	<figcaption class="grid border-t border-line px-4 py-3.5 text-sm leading-relaxed text-pretty">
		<div class={panelClass} data-panel="default" data-visible="true">
			<p class="mb-1.5 font-mono text-[0.78rem] text-muted" data-monolith-hint hidden>{copy.hint}</p>
			<p class="text-muted">{copy.caption}</p>
		</div>
		{layers.map((layer, index) => (
			<div id={`${uid}-layer-${index}`} class={panelClass} data-panel={index} data-visible="false">
				<p class="font-mono text-[0.78rem] text-accent">{layer.name} · {layer.detail}</p>
				<p class="mt-1.5">{layer.rule}</p>
			</div>
		))}
	</figcaption>
</figure>

<script>
	import { sequenceFigure } from '../../../scripts/figure-sequence';

	document.querySelectorAll<HTMLElement>('[data-monolith]').forEach((figure) => {
		const buttons = Array.from(figure.querySelectorAll<HTMLButtonElement>('[data-monolith-legend] [data-layer]'));
		const bars = Array.from(figure.querySelectorAll<HTMLElement>('[data-bar]'));
		const panels = Array.from(figure.querySelectorAll<HTMLElement>('[data-panel]'));

		// Same contract as the case study's diagram: hover and keyboard focus preview a layer, a tap pins it.
		let pinned: number | null = null;
		let preview: number | null = null;

		const render = () => {
			const active = preview ?? pinned;

			bars.forEach((bar) => {
				bar.dataset.state = active === null ? 'idle' : bar.dataset.bar === String(active) ? 'active' : 'dimmed';
			});
			buttons.forEach((button, index) => button.setAttribute('aria-pressed', String(index === pinned)));
			panels.forEach((panel) => {
				panel.dataset.visible = String(panel.dataset.panel === (active === null ? 'default' : String(active)));
			});
		};

		buttons.forEach((button, index) => {
			button.addEventListener('pointerenter', (event) => {
				if (event.pointerType === 'touch') return;
				preview = index;
				render();
			});
			button.addEventListener('pointerleave', () => {
				preview = null;
				render();
			});
			button.addEventListener('focus', () => {
				if (!button.matches(':focus-visible')) return;
				preview = index;
				render();
			});
			button.addEventListener('blur', () => {
				preview = null;
				render();
			});
			button.addEventListener('click', () => {
				pinned = pinned === index ? null : index;
				render();
			});
		});

		figure.addEventListener('keydown', (event) => {
			if (event.key !== 'Escape' || (pinned === null && preview === null)) return;
			pinned = null;
			preview = null;
			render();
		});

		// The hint only makes sense once the layers actually respond.
		figure.querySelector<HTMLElement>('[data-monolith-hint]')?.removeAttribute('hidden');
		sequenceFigure(figure);
	});
</script>

<style>
	/* Hidden only while a sequence is pending, so without the script the figure is simply there. Hiding
	   is instant; only showing transitions, so a replay starts from scratch. */
	[data-sequence] [data-at]:not([data-shown]) {
		opacity: 0;
	}

	[data-sequence] .seq-rise:not([data-shown]) {
		transform: translate3d(0, 6px, 0);
	}

	[data-sequence] .seq-arrow:not([data-shown]) {
		transform: translate3d(-6px, 0, 0);
	}

	[data-sequence] .seq-pop:not([data-shown]) {
		transform: scale(0.96);
	}

	/* Each module's layers draw in from the left once its tile lands, top to bottom. */
	[data-sequence] [data-tile]:not([data-shown]) .seq-bar {
		transform: scaleX(0);
	}

	.seq-bar {
		transform-origin: left;
	}

	@media (max-width: 47.99rem) {
		/* Stacked, the arrow points down, so it slides in from above. */
		[data-sequence] .seq-arrow:not([data-shown]) {
			transform: translate3d(0, -6px, 0);
		}
	}

	[data-sequence] [data-at][data-shown] {
		transition:
			opacity 360ms var(--ease-out-quart),
			transform 420ms var(--ease-out-quart);
	}

	[data-sequence] [data-tile][data-shown] .seq-bar {
		transition:
			transform 320ms var(--ease-out-quart),
			opacity 200ms var(--ease-out-quart),
			border-color 200ms var(--ease-out-quart);
	}

	[data-sequence] [data-tile][data-shown] .seq-bar:nth-child(2) {
		transition-delay: 60ms, 0ms, 0ms;
	}

	[data-sequence] [data-tile][data-shown] .seq-bar:nth-child(3) {
		transition-delay: 120ms, 0ms, 0ms;
	}

	[data-sequence] [data-tile][data-shown] .seq-bar:nth-child(4) {
		transition-delay: 180ms, 0ms, 0ms;
	}
</style>
