---
import Icon from '../common/Icon.astro';
import type { Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/translations';
import { getTechnologies } from '../../data/technologies';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale).approach;
const tools = getTechnologies(locale).flatMap((category) => category.items);
const labelClass = 'font-mono text-[0.8125rem] font-normal text-muted';
---

<section id="enfoque" class="page-shell border-t border-line py-section">
	<h2
		class="max-w-[19em] text-balance font-display text-[clamp(1.75rem,3.8vw,3.25rem)] font-medium leading-[1.12] tracking-[-0.025em]"
		data-animate-reveal="up"
	>
		{t.titleLead} <span class="text-muted">{t.titleRest}</span>
	</h2>

	<div class="mt-block flex flex-wrap gap-x-18 gap-y-block">
		<div class="min-w-0 flex-[1_1_23rem]">
			<h3 class={labelClass}>{t.changesLabel}</h3>
			<ul class="mt-4 border-b border-line">
				{t.changes.map((change, index) => (
					<li class="border-t border-line py-5" data-animate-reveal="up" data-animate-reveal-delay={index * 80}>
						<p class="text-pretty text-muted">{change.from}</p>
						<p class="mt-1 text-pretty font-medium">{change.to}</p>
					</li>
				))}
			</ul>
		</div>

		<div class="min-w-0 flex-[1_1_23rem]">
			<h3 class={labelClass}>{t.principlesLabel}</h3>
			<ul class="mt-4 border-b border-line">
				{t.principles.map((principle, index) => (
					<li class="border-t border-line py-5" data-animate-reveal="up" data-animate-reveal-delay={index * 80}>
						<p class="font-medium">{principle.title}</p>
						<p class="mt-1 text-pretty text-muted">{principle.description}</p>
					</li>
				))}
			</ul>
		</div>
	</div>

	<h3 class:list={[labelClass, 'mt-block']}>{t.toolsLabel}</h3>
	<ul class="mt-4 flex flex-wrap gap-px border border-line bg-line">
		{tools.map((tool) => (
			<li class="flex min-w-0 flex-[1_1_8rem] flex-col gap-3.5 bg-canvas px-4.5 py-5.5 transition-colors hover:text-accent">
				<Icon name={tool.icon} class="size-7" />
				<span class="text-[0.9375rem]">{tool.label}</span>
			</li>
		))}
	</ul>
</section>
