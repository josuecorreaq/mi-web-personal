---
import ProjectFeature from '../projects/ProjectFeature.astro';
import type { Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/translations';
import { getProjects } from '../../data/projects';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale).projects;
const projects = getProjects(locale);
---

<section id="proyectos" class="page-shell border-t border-line py-section">
	<div class="flex flex-wrap items-center justify-between gap-x-12 gap-y-3">
		<h2 class="font-display text-[clamp(2rem,4vw,3.25rem)] font-heading leading-[1.05] tracking-[-0.03em]">
			{t.title}
		</h2>
		<p class="max-w-[28em] text-pretty text-muted">{t.copy}</p>
	</div>

	<div class="mt-block grid gap-block">
		{projects.map((project, index) => (
			<ProjectFeature
				project={project}
				labels={t.labels}
				reversed={index % 2 === 1}
				divided={index > 0}
			/>
		))}
	</div>
</section>