---
import ProjectCard from '../projects/ProjectCard.astro';
import type { Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/translations';
import { getProjects } from '../../data/projects';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const projects = getProjects(locale);
---

<section id="proyectos" class="border-b border-line bg-canvas">
	<div class="page-shell py-16 sm:py-20 lg:py-24">
		<p class="section-kicker" data-animate-text="whole">{t.projects.kicker}</p>
		<h2 class="section-title" data-animate-text="words" data-animate-delay="80">{t.projects.title}</h2>
		<div class="mt-10 grid gap-4 lg:gap-5">
			{projects.map((project, index) => (
				<ProjectCard project={project} labels={t.projects.labels} index={index} href={project.path} />
			))}
		</div>
	</div>
</section>