---
import type { Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/translations';
import CvModal from '../cv/CvModal.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale).experience;
---

<section id="experiencia" class="border-b border-line bg-canvas">
	<div class="page-shell section-shell">
		<p class="section-kicker" data-animate-text="whole">{t.kicker}</p>
		<h2 class="section-title" data-animate-text="words" data-animate-delay="80">{t.title}</h2>

		<div class="mt-14 grid gap-10 lg:grid-cols-[minmax(0,0.34fr)_minmax(0,1fr)] lg:gap-16">
			<div class="lg:sticky lg:top-28 lg:self-start" data-animate-reveal="up">
				<p class="font-mono text-xs font-semibold uppercase tracking-[0.12em] text-accent">{t.period}</p>
				<h3 class="mt-4 text-balance font-display text-2xl font-semibold tracking-[-0.03em] text-ink sm:text-3xl">
					{t.role}
				</h3>
				<p class="mt-3 text-sm leading-6 text-muted">{t.organization}</p>

				<button
					type="button"
					class="mt-7 inline-flex min-h-12 items-center justify-center gap-2 border border-line bg-transparent px-5 py-3 font-mono text-sm font-bold text-ink transition-colors hover:border-accent hover:bg-surface hover:text-accent"
					data-cv-open
				>
					{t.cvCta}
					<span aria-hidden="true">↗</span>
				</button>
			</div>

			<div>
				<p class="max-w-3xl text-pretty text-base leading-7 text-muted sm:text-lg" data-animate-text="whole" data-animate-delay="120">
					{t.description}
				</p>

				<ul class="mt-10 grid" data-animate-reveal="up" data-animate-reveal-delay="160">
					{t.highlights.map((highlight) => (
						<li class="flex gap-4 border-t border-line py-5 text-sm leading-6 text-ink first:border-t-0 first:pt-0 last:pb-0">
							<span class="mt-2.5 size-1 shrink-0 bg-accent" aria-hidden="true" />
							<span class="text-pretty">{highlight}</span>
						</li>
					))}
				</ul>
			</div>
		</div>
	</div>

	<CvModal locale={locale} />
</section>
