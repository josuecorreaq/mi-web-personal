---
import MetaList from '../common/MetaList.astro';
import type { Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/translations';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale).experience;
---

<section id="trayectoria" class="page-shell border-t border-line py-section">
	<div class="flex flex-wrap items-center justify-between gap-x-12 gap-y-3">
		<h2 class="font-display text-[clamp(2rem,4vw,3.25rem)] font-medium leading-[1.05] tracking-[-0.03em]">
			{t.title}
		</h2>
		<p class="max-w-[28em] text-pretty text-muted">{t.copy}</p>
	</div>

	<ol class="mt-block grid gap-block">
		{t.items.map((item, index) => (
			<li
				class:list={['flex flex-wrap gap-x-16 gap-y-5', index > 0 && 'border-t border-line pt-block']}
				data-animate-reveal="up"
			>
				<div class="flex-[0_1_20rem]">
					<p
						class:list={[
							'font-display text-[clamp(3.25rem,7vw,6rem)] font-medium leading-[0.9] tracking-[-0.04em] tabular-nums',
							!item.current && 'text-muted',
						]}
					>
						{item.year}
					</p>
					<p class="mt-4 flex flex-wrap items-center gap-x-3.5 gap-y-1.5 font-mono text-[0.8125rem] text-muted">
						<span>{item.range}</span>
						{item.current && (
							<span class="inline-flex items-center gap-2 text-ink">
								<span class="size-[7px] bg-accent" aria-hidden="true"></span>
								{t.currentLabel}
							</span>
						)}
					</p>
				</div>

				<div class="min-w-0 flex-[1_1_26rem] pt-1.5">
					<h3 class="font-display text-[clamp(1.5rem,2.4vw,1.875rem)] font-medium leading-[1.15] tracking-[-0.02em]">
						{item.role}
					</h3>
					<MetaList items={[item.organization, item.project]} class="mt-2 text-[0.9375rem] text-muted" />
					<ul class="mt-4.5 grid gap-2">
						{item.highlights.map((highlight) => (
							<li class="flex gap-3.5 text-pretty">
								<span
									class:list={['mt-[0.7rem] size-[5px] shrink-0', item.current ? 'bg-accent' : 'bg-muted']}
									aria-hidden="true"
								></span>
								{highlight}
							</li>
						))}
					</ul>
				</div>
			</li>
		))}
	</ol>
</section>
