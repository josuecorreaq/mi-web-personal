---
import type { Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/translations';
import CvModal from '../cv/CvModal.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale).experience;
---

<section id="experiencia" class="border-b border-line bg-canvas">
	<div class="page-shell section-shell">
		<div class="flex flex-col gap-8 sm:flex-row sm:items-end sm:justify-between sm:gap-10">
			<div>
				<p class="section-kicker" data-animate-text="whole">{t.kicker}</p>
				<h2 class="section-title" data-animate-text="words" data-animate-delay="80">{t.title}</h2>
			</div>

			<button
				type="button"
				class="inline-flex min-h-12 shrink-0 items-center justify-center gap-2 self-start border border-line bg-transparent px-5 py-3 font-mono text-sm font-bold text-ink transition-colors hover:border-accent hover:bg-surface hover:text-accent sm:self-auto"
				data-cv-open
			>
				{t.cvCta}
				<span aria-hidden="true">↗</span>
			</button>
		</div>

		<ol class="mt-14">
			{t.items.map((item, index) => (
				<li
					class="relative border-l border-line pb-16 pl-7 last:pb-0 sm:pl-10"
					data-animate-reveal="up"
					data-animate-reveal-delay={Math.min(index * 80, 240)}
				>
					<span
						class:list={[
							'absolute -left-[4.5px] top-1 size-2',
							item.current ? 'bg-accent shadow-[0_0_0_5px] shadow-accent/15' : 'border border-line bg-elevated',
						]}
						aria-hidden="true"
					/>

					<div class="grid gap-8 lg:grid-cols-[minmax(0,0.32fr)_minmax(0,1fr)] lg:gap-14">
						<div>
							<p class="font-mono text-xs font-semibold uppercase tracking-[0.12em] text-accent">{item.period}</p>
							<h3 class="mt-4 text-balance font-display text-2xl font-semibold tracking-[-0.03em] text-ink sm:text-3xl">
								{item.role}
							</h3>
							<p class="mt-3 text-sm leading-6 text-muted">{item.organization}</p>
						</div>

						<div>
							<p class="max-w-3xl text-pretty text-base leading-7 text-muted sm:text-lg">
								{item.description}
							</p>

							<ul class="mt-8 grid">
								{item.highlights.map((highlight) => (
									<li class="flex gap-4 border-t border-line py-5 text-sm leading-6 text-muted first:border-t-0 first:pt-0 last:pb-0">
										<span class="mt-2.5 size-1 shrink-0 bg-accent" aria-hidden="true" />
										<span class="text-pretty">{highlight}</span>
									</li>
								))}
							</ul>
						</div>
					</div>
				</li>
			))}
		</ol>
	</div>

	<CvModal locale={locale} />
</section>