---
import type { Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/translations';
import { social } from '../../data/social';
import Icon from '../common/Icon.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const contactEndpoint = import.meta.env.PUBLIC_CONTACT_API_URL ?? '/api/contact';
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const fieldId = (name: string) => `${locale}-contact-${name}`;
const statusId = fieldId('status');
const channels = [
	{ label: t.contact.email, value: social.email, href: `mailto:${social.email}`, icon: 'email', external: false },
	{ label: t.contact.linkedin, value: social.linkedin.handle.replace('linkedin.com/', ''), href: social.linkedin.url, icon: 'briefcase', external: true },
	{ label: t.contact.github, value: `@${social.github.handle.replace('github.com/', '')}`, href: social.github.url, icon: 'github', external: true },
] as const;
const channelLinkClass = 'group flex min-h-22 min-w-0 flex-auto items-center gap-3.5 py-3.5 sm:gap-4.5';
const channelIconClass =
	'grid size-10 flex-none place-items-center sm:size-12 border border-on-drench transition-colors duration-200 group-hover:bg-on-drench group-hover:text-drench';
const channelValueClass =
	'block font-display text-[clamp(1rem,1.8vw,1.375rem)] font-medium leading-[1.3] [overflow-wrap:anywhere]';
const fieldClass =
	'min-h-12 w-full border border-on-drench bg-transparent px-3.5 py-3 text-base text-on-drench placeholder:text-drench-muted focus:outline-2 focus:outline-offset-2 focus:outline-on-drench';
---

<section id="contacto" class="drench bg-drench text-on-drench">
	<div class="page-shell py-section">
		<h2
			class="max-w-[11em] text-balance font-display text-[clamp(2.5rem,6vw,5rem)] font-medium leading-[1.02] tracking-[-0.03em]"
			data-animate-text="words"
		>
			{t.contact.title}
		</h2>

		<div class="mt-block flex flex-wrap gap-x-20 gap-y-block">
			<div class="min-w-0 flex-[1_1_23rem]" data-animate-reveal="up" data-animate-reveal-delay="120">
				<p class="font-mono text-[0.8125rem] text-drench-muted">{t.contact.channelsLabel}</p>
				<ul class="mt-4 border-t border-on-drench/30">
					{channels.map((channel) => (
						<li class="border-b border-on-drench/30">
							<a
								href={channel.href}
								target={channel.external ? '_blank' : undefined}
								rel={channel.external ? 'noopener noreferrer' : undefined}
								class={channelLinkClass}
							>
								<span class={channelIconClass}>
									<Icon name={channel.icon} class="size-5" />
								</span>
								<span class="min-w-0 flex-auto">
									<span class="block font-mono text-[0.78rem] text-drench-muted">{channel.label}</span>
									<span class={channelValueClass}>{channel.value}</span>
								</span>
								<Icon name="arrow-up-right" class="size-5 shrink-0 transition-transform duration-200 group-hover:translate-x-[3px] group-hover:-translate-y-[3px]" />
								{channel.external && <span class="sr-only">, {t.contact.open}</span>}
							</a>
						</li>
					))}
				</ul>
			</div>

			<form
				class="grid min-w-0 flex-[1_1_27rem] gap-4.5"
				data-animate-reveal="up"
				data-animate-reveal-delay="200"
				action={contactEndpoint}
				method="post"
				aria-describedby={statusId}
				data-contact-form
				data-endpoint={contactEndpoint}
				data-submit-label={t.contact.form.submit}
				data-sending-label={t.contact.form.sending}
				data-success-message={t.contact.form.success}
				data-error-message={t.contact.form.error}
				data-rate-limit-message={t.contact.form.rateLimit}
				data-turnstile-required-message={t.contact.form.turnstileRequired}
				data-turnstile-error-message={t.contact.form.turnstileError}
				data-modal-success-title={t.contact.form.successTitle}
				data-modal-error-title={t.contact.form.errorTitle}
				data-turnstile-enabled={turnstileSiteKey ? 'true' : 'false'}
			>
				<div class="flex flex-wrap gap-4.5">
					<div class="grid min-w-0 flex-[1_1_12.5rem] gap-1.5">
						<label class="text-[0.9375rem] font-medium" for={fieldId('name')}>{t.contact.form.name}</label>
						<input
							id={fieldId('name')}
							name="name"
							type="text"
							required
							pattern="[^0-9]*"
							maxlength="80"
							autocomplete="name"
							placeholder={t.contact.form.namePlaceholder}
							title={t.contact.form.nameInvalid}
							data-no-digits
							class={fieldClass}
						/>
					</div>
					<div class="grid min-w-0 flex-[1_1_12.5rem] gap-1.5">
						<label class="text-[0.9375rem] font-medium" for={fieldId('email')}>{t.contact.form.email}</label>
						<input
							id={fieldId('email')}
							name="email"
							type="email"
							required
							maxlength="254"
							autocomplete="email"
							placeholder={t.contact.form.emailPlaceholder}
							class={fieldClass}
						/>
					</div>
				</div>
				<div class="grid gap-1.5">
					<label class="text-[0.9375rem] font-medium" for={fieldId('message')}>{t.contact.form.message}</label>
					<textarea
						id={fieldId('message')}
						name="message"
						required
						minlength="10"
						maxlength="2000"
						rows="4"
						placeholder={t.contact.form.messagePlaceholder}
						class:list={[fieldClass, 'min-h-33 resize-y leading-relaxed']}
					></textarea>
				</div>
				<div class="absolute -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true">
					<label for={fieldId('website')}>{t.contact.form.website}</label>
					<input
						id={fieldId('website')}
						name="website"
						type="text"
						tabindex="-1"
						autocomplete="off"
					/>
				</div>
				{
					turnstileSiteKey && (
						<div class="min-h-[65px]" data-turnstile-wrapper>
							<div
								class="cf-turnstile"
								data-sitekey={turnstileSiteKey}
								data-theme="light"
								data-size="normal"
							/>
						</div>
					)
				}
				<div>
					<button
						type="submit"
						class="inline-flex min-h-12 items-center justify-center gap-2.5 border border-on-drench bg-on-drench px-5.5 font-mono text-sm font-semibold text-drench transition-[opacity,translate] hover:opacity-90 active:translate-y-px disabled:cursor-not-allowed disabled:opacity-60"
					>
						<span data-submit-text>{t.contact.form.submit}</span>
						<Icon name="arrow-right" class="size-4 shrink-0" />
					</button>
					<p
						id={statusId}
						class="sr-only"
						role="status"
						aria-live="polite"
						data-contact-status
					></p>
				</div>
				<dialog
					class="m-auto w-[calc(100%-2rem)] max-w-md border border-line bg-surface p-0 text-ink backdrop:bg-black/75"
					aria-labelledby={fieldId('modal-title')}
					aria-describedby={fieldId('modal-message')}
					data-contact-modal
				>
					<div class="p-5 sm:p-6">
						<div class="flex items-start gap-4">
							<span
								class="grid size-11 shrink-0 place-items-center border border-accent bg-accent/5 text-accent"
								data-contact-modal-success-icon
								aria-hidden="true"
							>
								<Icon name="circle-check" class="size-5" />
							</span>
							<span
								class="grid size-11 shrink-0 place-items-center border border-red-400/60 bg-red-500/10 text-red-300"
								data-contact-modal-error-icon
								aria-hidden="true"
								hidden
							>
								<Icon name="circle-alert" class="size-5" />
							</span>
							<div class="min-w-0 flex-1">
								<p
									id={fieldId('modal-title')}
									class="font-display text-xl font-semibold leading-tight text-ink"
									data-contact-modal-title
								></p>
								<p
									id={fieldId('modal-message')}
									class="mt-3 text-pretty text-sm leading-6 text-muted"
									data-contact-modal-message
								></p>
							</div>
						</div>
						<div class="mt-6 flex justify-end">
							<button
								type="button"
								class="inline-flex min-h-11 items-center justify-center border border-line bg-canvas px-4 py-2 font-mono text-xs font-bold uppercase tracking-[0.08em] text-ink transition-colors hover:border-accent hover:text-accent"
								autofocus
								data-contact-modal-close
							>
								{t.contact.form.close}
							</button>
						</div>
					</div>
				</dialog>
			</form>
		</div>
	</div>
</section>