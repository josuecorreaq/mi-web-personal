---
import Icon from '../common/Icon.astro';
import type { Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/translations';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale).hero;
const leadClass =
	'ml-(--optical-inset) max-w-[14em] font-display text-[length:clamp(2rem,min(5.2vw,7.8svh),4.75rem)] font-heading leading-[1.06] tracking-[-0.03em] text-balance';
const statementClass =
	'ml-(--optical-inset) mt-[clamp(0.75rem,2svh,1.25rem)] max-w-[19em] font-display text-[length:clamp(1.625rem,min(3.8vw,5.8svh),3.5rem)] font-heading leading-[1.12] tracking-[-0.025em] text-balance text-muted';
---

<section id="inicio" class="page-shell flex flex-col justify-center lg:min-h-[calc(100svh-7.5rem)]">
	<div class="flex flex-row-reverse flex-wrap items-center justify-end gap-x-20 gap-y-6 pt-[clamp(1rem,5svh,3rem)] lg:pt-[calc(clamp(1rem,5svh,3rem)_+_3svh)]">
		<div
			class="aspect-square w-[clamp(6rem,min(20vw,36svh),18rem)] flex-none rounded-full border border-line p-[clamp(0.3rem,0.6vw,0.5rem)]"
			data-animate-reveal="scale"
			data-animate-reveal-delay="200"
		>
			<div class="size-full overflow-hidden rounded-full bg-elevated">
				<img
					src="/images/profile.webp"
					width="288"
					height="288"
					alt={t.profileAlt}
					decoding="async"
					fetchpriority="high"
					class="block size-full origin-[50%_30%] scale-[1.12] object-cover object-[50%_16%] brightness-[0.94] contrast-[1.04] grayscale"
				/>
			</div>
		</div>

		<div class="min-w-0 flex-[1_1_35rem]">
			<h1 class={leadClass} data-animate-text="words">
				{t.lead}
			</h1>
			<p class={statementClass} data-animate-reveal="up" data-animate-reveal-delay="260">
				{t.statement}{' '}<mark class="whitespace-nowrap bg-transparent px-[0.06em] text-accent">{t.statementMark}</mark>.
			</p>
		</div>
	</div>

	<div
		class="mt-[clamp(2.5rem,7.5svh,4.5rem)] flex flex-wrap lg:mt-[calc(clamp(2.5rem,7.5svh,4.5rem)_+_3svh)] items-end justify-between gap-x-16 gap-y-5 pb-section lg:pb-[clamp(1.25rem,4svh,3rem)]"
		data-animate-reveal="up"
		data-animate-reveal-delay="380"
	>
		<div class="flex flex-wrap items-center gap-x-6 gap-y-3">
			<a
				href="#contacto"
				data-scroll-target="contacto"
				class="group inline-flex min-h-12 items-center gap-2.5 border border-brand-edge bg-brand px-5.5 font-mono text-sm font-semibold text-on-brand transition-[background-color,translate] hover:bg-brand-hover active:translate-y-px"
			>
				{t.contactCta}
				<Icon name="arrow-right" class="size-4 shrink-0 transition-transform duration-200 group-hover:translate-x-[3px]" />
			</a>
			<a
				href="#proyectos"
				data-scroll-target="proyectos"
				class="group inline-flex min-h-12 items-center gap-2 font-mono text-sm font-semibold text-ink transition-colors hover:text-accent"
			>
				{/* Next to the primary button it keeps a hairline at rest; on hover the drawn rule of the other text links runs over it. */}
				<span class="link-rule link-rule-rest">
					{t.projectsCta}
				</span>
				<Icon name="arrow-down" class="size-4 shrink-0 transition-transform duration-200 group-hover:translate-y-[3px]" />
			</a>
		</div>

		<dl class="flex flex-wrap gap-x-12 gap-y-4">
			{t.facts.map((fact) => (
				<div>
					<dt class="flex items-center gap-1.5 font-mono text-[0.78rem] text-muted">
						<Icon name={fact.icon} class="size-3.5 shrink-0 text-accent" />
						{fact.label}
					</dt>
					<dd class="mt-1 pl-5 text-[0.9375rem]">{fact.value}</dd>
				</div>
			))}
		</dl>
	</div>
</section>