---
import type { Locale } from '../../i18n/config';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const labels =
	locale === 'es'
		? { light: 'Cambiar a tema claro', dark: 'Cambiar a tema oscuro' }
		: { light: 'Switch to light theme', dark: 'Switch to dark theme' };
---

<button
	type="button"
	class="theme-toggle"
	data-theme-toggle
	aria-label={labels.light}
	data-label-light={labels.light}
	data-label-dark={labels.dark}
	data-tooltip={labels.light}
>
	<svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true">
		<circle cx="12" cy="12" r="3.5"></circle>
		<path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"></path>
	</svg>
	<svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true">
		<path d="M20.3 15.4A8.5 8.5 0 0 1 8.6 3.7 8.5 8.5 0 1 0 20.3 15.4Z"></path>
	</svg>
</button>

<script>
	const root = document.documentElement;
	const toggles = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
	let themeTransition: ViewTransition | null = null;

	const setTheme = (theme: 'light' | 'dark') => {
		root.dataset.theme = theme;
		const switchesToLight = theme === 'dark';

		toggles.forEach((toggle) => {
			const label = switchesToLight ? toggle.dataset.labelLight : toggle.dataset.labelDark;

			if (label) {
				toggle.setAttribute('aria-label', label);
				toggle.dataset.tooltip = label;
			}
		});

		document
			.querySelector<HTMLMetaElement>('meta[name="theme-color"]')
			?.setAttribute('content', theme === 'dark' ? '#09090b' : '#f4f4f5');

		try {
			localStorage.setItem('theme', theme);
		} catch {
			// Theme still works when storage is blocked.
		}
	};

	toggles.forEach((toggle) => {
		toggle.addEventListener('click', () => {
			const nextTheme = root.dataset.theme === 'light' ? 'dark' : 'light';
			const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			if (!document.startViewTransition || reduceMotion) {
				setTheme(nextTheme);
				return;
			}

			// El barrido de global.css solo aplica mientras dure esta marca; las navegaciones
			// entre páginas conservan el fundido.
			root.dataset.themeSwitch = '';
			const transition = document.startViewTransition(() => setTheme(nextTheme));
			themeTransition = transition;

			// El navegador rechaza la transición si la pestaña está oculta o si otra la
			// interrumpe. El tema ya se aplicó; solo hay que evitar el rechazo sin capturar.
			transition.ready.catch(() => {});
			transition.finished
				.catch(() => {})
				.finally(() => {
					// Un segundo clic rápido reemplaza la transición; la marca es de la vigente.
					if (themeTransition === transition) delete root.dataset.themeSwitch;
				});
		});
	});

	const currentTheme = root.dataset.theme === 'light' ? 'light' : 'dark';
	setTheme(currentTheme);
</script>

<style>
	.theme-toggle {
		display: inline-grid;
		width: 2.75rem;
		flex: none;
		place-items: center;
		background: transparent;
		color: var(--color-ink);
		transition: background-color 160ms ease;
	}

	.theme-icon {
		grid-area: 1 / 1;
		width: 1.125rem;
		height: 1.125rem;
		fill: none;
		stroke: currentColor;
		stroke-linecap: square;
		stroke-linejoin: miter;
		stroke-width: 1.7;
		transition:
			opacity 200ms ease,
			transform 320ms cubic-bezier(0.2, 0, 0, 1),
			scale 120ms ease;
	}

	.theme-icon-moon,
	:global(:root[data-theme='light']) .theme-icon-sun {
		opacity: 0;
		transform: rotate(-90deg) scale(0.5);
	}

	.theme-icon-sun,
	:global(:root[data-theme='light']) .theme-icon-moon {
		opacity: 1;
		transform: none;
	}

	.theme-toggle:active .theme-icon {
		scale: 0.88;
	}

	@media (hover: hover) {
		.theme-toggle:hover {
			background: var(--nav-hover-tint, color-mix(in oklab, currentColor 8%, transparent));
		}

		:global(:root:not([data-theme='light'])) .theme-toggle:hover .theme-icon-sun {
			transform: rotate(45deg);
		}

		:global(:root[data-theme='light']) .theme-toggle:hover .theme-icon-moon {
			transform: rotate(-15deg);
		}
	}
</style>
