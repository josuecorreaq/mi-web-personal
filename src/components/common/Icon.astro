---
import ArrowDown from '@lucide/astro/icons/arrow-down';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import Blocks from '@lucide/astro/icons/blocks';
import Briefcase from '@lucide/astro/icons/briefcase';
import ChevronDown from '@lucide/astro/icons/chevron-down';
import CircleAlert from '@lucide/astro/icons/circle-alert';
import CircleCheck from '@lucide/astro/icons/circle-check';
import CodeXml from '@lucide/astro/icons/code-xml';
import ExternalLink from '@lucide/astro/icons/external-link';
import FileText from '@lucide/astro/icons/file-text';
import FileSearch from '@lucide/astro/icons/file-search';
import Layers from '@lucide/astro/icons/layers';
import Mail from '@lucide/astro/icons/mail';
import MapPin from '@lucide/astro/icons/map-pin';
import Send from '@lucide/astro/icons/send';
import ShieldCheck from '@lucide/astro/icons/shield-check';
import Split from '@lucide/astro/icons/split';
import X from '@lucide/astro/icons/x';
import { siGithub, siX } from 'simple-icons';

const brandIcons = {
	github: siGithub,
	x: siX,
	// simple-icons dropped the LinkedIn mark; this path comes from Bootstrap Icons (MIT), drawn on a 16px grid.
	linkedin: {
		viewBox: '0 0 16 16',
		path: 'M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854zm4.943 12.248V6.169H2.542v7.225zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248S2.4 3.226 2.4 3.934c0 .694.521 1.248 1.327 1.248zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016l.016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225z',
	},
} as const;

const genericIcons = {
	'circle-alert': CircleAlert,
	'circle-check': CircleCheck,
	'clean-code': CodeXml,
	'modular-architecture': Blocks,
	'jwt-security': ShieldCheck,
	'scattered-data': Split,
	traceability: FileSearch,
	email: Mail,
	location: MapPin,
	stack: Layers,
	'external-link': ExternalLink,
	'arrow-up-right': ArrowUpRight,
	'arrow-right': ArrowRight,
	'arrow-down': ArrowDown,
	briefcase: Briefcase,
	file: FileText,
	chevron: ChevronDown,
	send: Send,
	close: X,
} as const;

type BrandIconName = keyof typeof brandIcons;
type GenericIconName = keyof typeof genericIcons;
export type IconName = BrandIconName | GenericIconName;

interface Props {
	name: IconName;
	class?: string;
}

const { name } = Astro.props;
const className = Astro.props.class ?? 'size-4';
const brandIcon = brandIcons[name as BrandIconName];
const GenericIcon = genericIcons[name as GenericIconName];
---

{
	brandIcon ? (
		<svg class={className} viewBox={'viewBox' in brandIcon ? brandIcon.viewBox : '0 0 24 24'} fill="currentColor" aria-hidden="true">
			<path d={brandIcon.path} />
		</svg>
	) : (
		<GenericIcon class={className} aria-hidden="true" stroke-width={1.8} />
	)
}
