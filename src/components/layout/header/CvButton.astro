---
import type { Locale } from '../../../i18n/config';
import { useTranslations } from '../../../i18n/translations';
import Icon from '../../common/Icon.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<button type="button" class="cv-button" aria-label={t.nav.cvLabel} data-cv-open>
	<Icon name="file" class="size-4 shrink-0" />
	<span class="max-[22.5rem]:sr-only">{t.nav.cv}</span>
</button>

<style>
	/* The brand fill rises on hover, the same yellow as the primary action. */
	.cv-button {
		position: relative;
		isolation: isolate;
		display: inline-flex;
		min-width: 2.75rem;
		height: 2.75rem;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		border: 1px solid var(--color-line);
		padding-inline: 0.875rem;
		color: var(--color-ink);
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		font-weight: 600;
		transition:
			color 160ms ease,
			border-color 160ms ease;
	}

	.cv-button::before {
		position: absolute;
		inset: 0;
		z-index: -1;
		background: var(--color-brand);
		content: '';
		transform: scaleY(0);
		transform-origin: bottom;
		transition: transform 200ms var(--nav-ease);
	}

	.cv-button:active {
		translate: 0 1px;
	}

	@media (hover: hover) {
		.cv-button:hover {
			border-color: var(--color-brand-edge);
			color: var(--color-on-brand);
		}

		.cv-button:hover::before {
			transform: scaleY(1);
		}
	}

	@media (width < 22.5rem) {
		.cv-button {
			padding-inline: 0;
		}
	}
</style>
