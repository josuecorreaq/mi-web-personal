---
import type { Locale } from '../../../i18n/config';
import { useTranslations } from '../../../i18n/translations';
import Icon from '../../common/Icon.astro';
import type { NavItem } from './types';

interface Props {
	locale: Locale;
	items: NavItem[];
}

const { locale, items } = Astro.props;
const t = useTranslations(locale);
---

<details class="mobile-menu lg:hidden" data-mobile-menu>
	<summary class="menu-button" aria-label={t.nav.menu}>
		<svg class="menu-icon" viewBox="0 0 24 24" aria-hidden="true">
			<path class="menu-icon-line" data-line="top" d="M4 7h16"></path>
			<path class="menu-icon-line" data-line="middle" d="M4 12h16"></path>
			<path class="menu-icon-line" data-line="bottom" d="M4 17h16"></path>
		</svg>
	</summary>
	<div class="mobile-menu-scrim" aria-hidden="true" data-mobile-menu-close></div>
	<nav class="mobile-menu-panel" aria-label={t.nav.mainLabel}>
		<ul class="page-shell">
			{items.map((item) => (
				<li>
					<a
						class="mobile-menu-link group"
						href={item.href}
						data-scroll-target={item.scrollTarget}
						data-nav-link={item.id}
						data-mobile-menu-link
						aria-current={item.current ? 'true' : undefined}
					>
						{item.label}
						<Icon name="arrow-right" class="size-4 shrink-0 text-muted transition-transform duration-200 group-hover:translate-x-[3px]" />
					</a>
				</li>
			))}
		</ul>
	</nav>
</details>

<script>
	const desktopQuery = window.matchMedia('(min-width: 64rem)');

	document.querySelectorAll<HTMLDetailsElement>('[data-mobile-menu]').forEach((menu) => {
		const summary = menu.querySelector<HTMLElement>('summary');

		const close = (restoreFocus = false) => {
			if (!menu.open) return;

			menu.open = false;

			if (restoreFocus) {
				summary?.focus();
			}
		};

		menu
			.querySelectorAll<HTMLElement>('[data-mobile-menu-link], [data-mobile-menu-close]')
			.forEach((control) => control.addEventListener('click', () => close()));

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && menu.open) close(true);
		});

		document.addEventListener('click', (event) => {
			if (menu.open && event.target instanceof Node && !menu.contains(event.target)) close();
		});

		desktopQuery.addEventListener('change', (event) => {
			if (event.matches) close();
		});
	});
</script>

<style>
	.menu-button {
		display: grid;
		width: 2.75rem;
		height: 2.75rem;
		place-items: center;
		border: 1px solid var(--color-line);
		color: var(--color-ink);
		list-style: none;
		transition:
			background-color 160ms ease,
			border-color 160ms ease,
			color 160ms ease;
	}

	.menu-button::-webkit-details-marker {
		display: none;
	}

	.mobile-menu[open] > .menu-button {
		border-color: var(--color-ink);
		background: var(--color-ink);
		color: var(--color-canvas);
	}

	.menu-icon {
		width: 1.125rem;
		height: 1.125rem;
		overflow: visible;
		fill: none;
		stroke: currentColor;
		stroke-linecap: square;
		stroke-width: 1.8;
	}

	.menu-icon-line {
		transform-box: fill-box;
		transform-origin: center;
		transition:
			opacity 160ms ease,
			transform 240ms var(--nav-ease);
	}

	.mobile-menu[open] .menu-icon-line[data-line='top'] {
		transform: translateY(5px) rotate(45deg);
	}

	.mobile-menu[open] .menu-icon-line[data-line='middle'] {
		opacity: 0;
		transform: scaleX(0.2);
	}

	.mobile-menu[open] .menu-icon-line[data-line='bottom'] {
		transform: translateY(-5px) rotate(-45deg);
	}

	.mobile-menu-scrim {
		position: absolute;
		top: 100%;
		right: 0;
		left: 0;
		height: 100dvh;
		background: color-mix(in oklab, var(--color-canvas) 72%, transparent);
		animation: mobile-menu-fade 200ms ease-out;
	}

	.mobile-menu-panel {
		position: absolute;
		top: 100%;
		right: 0;
		left: 0;
		border-block: 1px solid var(--color-line);
		background: var(--color-canvas);
		padding-bottom: 0.5rem;
		animation: mobile-menu-in 220ms var(--nav-ease);
	}

	.mobile-menu-link {
		position: relative;
		display: flex;
		min-height: 3.5rem;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		border-bottom: 1px solid var(--color-line);
		color: var(--color-muted);
		font-family: var(--font-display);
		font-size: 1.375rem;
		font-weight: var(--font-weight-heading);
		transition:
			background-color 160ms ease,
			color 160ms ease;
	}

	.mobile-menu-panel li:last-child .mobile-menu-link {
		border-bottom: 0;
	}

	/* Current section: an accent tick in the gutter keeps labels aligned with the logo. */
	.mobile-menu-link::before {
		position: absolute;
		top: 50%;
		left: -0.5rem;
		width: 2px;
		height: 1.25rem;
		margin-top: -0.625rem;
		background: var(--color-accent);
		content: '';
		transform: scaleY(0);
		transition: transform 200ms var(--nav-ease);
	}

	.mobile-menu-link[aria-current] {
		color: var(--color-ink);
	}

	.mobile-menu-link[aria-current]::before {
		transform: scaleY(1);
	}

	.mobile-menu-link:active {
		background: var(--nav-hover-tint);
	}

	@media (hover: hover) {
		.menu-button:hover {
			background: var(--nav-hover-tint);
		}

		.mobile-menu-link:hover {
			color: var(--color-ink);
		}
	}

	/* The links follow the panel down one after another, 30ms apart. */
	@media (prefers-reduced-motion: no-preference) {
		.mobile-menu-panel li {
			animation: mobile-menu-in 200ms var(--nav-ease) backwards;
		}

		.mobile-menu-panel li:nth-child(n + 2) {
			animation-delay: 30ms;
		}

		.mobile-menu-panel li:nth-child(n + 3) {
			animation-delay: 60ms;
		}

		.mobile-menu-panel li:nth-child(n + 4) {
			animation-delay: 90ms;
		}
	}

	@keyframes mobile-menu-in {
		from {
			opacity: 0;
			transform: translateY(-0.375rem);
		}
	}

	@keyframes mobile-menu-fade {
		from {
			opacity: 0;
		}
	}
</style>
