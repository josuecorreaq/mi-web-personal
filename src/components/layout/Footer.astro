---
import Icon, { type IconName } from '../common/Icon.astro';
import type { Locale } from '../../i18n/config';
import { social } from '../../data/social';

interface Props {
	locale: Locale;
	/** `drench` continues the yellow contact block that closes the landing and case studies; `plain` is for pages without one (404). */
	tone?: 'drench' | 'plain';
}

const { locale, tone = 'plain' } = Astro.props;
const name = locale === 'es' ? 'Josué Correa' : 'Josue Correa';
const year = new Date().getFullYear();
const newTabLabel = locale === 'es' ? 'se abre en otra pestaña' : 'opens in a new tab';
const links: { label: string; href: string; icon: IconName; external: boolean }[] = [
	{ label: 'GitHub', href: social.github.url, icon: 'github', external: true },
	{ label: 'Email', href: `mailto:${social.email}`, icon: 'email', external: false },
	{ label: 'X', href: social.x.url, icon: 'x', external: true },
];
---

<footer class:list={[tone === 'drench' ? 'drench bg-drench text-on-drench' : 'border-t border-line bg-canvas text-muted']}>
	<div class="page-shell">
		<div
			class:list={[
				'flex flex-wrap items-center justify-between gap-x-6 gap-y-1 pb-6 pt-4 font-mono text-[0.8125rem]',
				tone === 'drench' && 'border-t border-on-drench/30',
			]}
		>
			<p>© {year} {name}</p>
			<nav class="-mr-3 flex gap-x-1" aria-label={locale === 'es' ? 'Redes' : 'Social'}>
				{links.map((link) => (
					<a
						href={link.href}
						target={link.external ? '_blank' : undefined}
						rel={link.external ? 'noopener noreferrer' : undefined}
						title={link.label}
						class:list={[
							'inline-flex size-11 items-center justify-center transition-[color,opacity]',
							tone === 'plain' ? 'hover:text-ink' : 'hover:opacity-70',
						]}
					>
						<Icon name={link.icon} class="size-[1.125rem]" />
						<span class="sr-only">
							{link.label}
							{link.external && `, ${newTabLabel}`}
						</span>
					</a>
				))}
			</nav>
		</div>
	</div>
</footer>
