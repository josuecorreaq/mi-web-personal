---
import type { Locale } from '../../i18n/config';
import { getLocalePath } from '../../i18n/config';
import { useTranslations } from '../../i18n/translations';
import { servicesPaths } from '../../data/services';
import ThemeToggle from '../common/ThemeToggle.astro';
import BrandMark from './header/BrandMark.astro';
import CvButton from './header/CvButton.astro';
import HeaderNav from './header/HeaderNav.astro';
import LanguageSwitch from './header/LanguageSwitch.astro';
import MobileMenu from './header/MobileMenu.astro';
import type { NavItem } from './header/types';

interface Props {
	locale: Locale;
	isLanding?: boolean;
	alternatePath?: string;
	currentSection?: string;
}

const { locale, isLanding = true, alternatePath, currentSection } = Astro.props;
const t = useTranslations(locale);
const basePath = getLocalePath(locale);
const sectionHref = (targetId: string) =>
	isLanding ? `#${targetId}` : `${basePath}#${targetId}`;
const scrollTarget = (targetId: string) => isLanding ? targetId : undefined;
const sectionItems: NavItem[] = [
	{ id: 'proyectos', label: t.nav.projects },
	{ id: 'enfoque', label: t.nav.approach },
	{ id: 'trayectoria', label: t.nav.trajectory },
	{ id: 'contacto', label: t.nav.contact },
].map((item) => ({
	...item,
	href: sectionHref(item.id),
	scrollTarget: scrollTarget(item.id),
	current: !isLanding && item.id === currentSection,
}));

const navItems: NavItem[] = [
	{
		id: 'servicios',
		label: t.nav.services,
		href: servicesPaths[locale],
		current: currentSection === 'servicios',
	},
	...sectionItems,
];
---

<header
	class="site-header sticky top-0 z-50 border-b border-line bg-canvas"
	data-site-header
	data-scroll-spy={isLanding ? 'true' : undefined}
>
	<div class="page-shell grid min-h-18 grid-cols-[1fr_auto] items-center gap-3 sm:gap-5 lg:grid-cols-[1fr_auto_1fr]">
		<BrandMark
			locale={locale}
			href={isLanding ? '#inicio' : basePath}
			scrollTarget={scrollTarget('inicio')}
		/>

		<HeaderNav locale={locale} items={navItems} />

		<div class="col-start-2 flex items-center gap-1.5 justify-self-end sm:gap-2 lg:col-start-3">
			<div class="flex h-11 items-stretch border border-line">
				<LanguageSwitch locale={locale} alternatePath={alternatePath} />
				<span class="w-px bg-line" aria-hidden="true"></span>
				<ThemeToggle locale={locale} />
			</div>

			<CvButton locale={locale} />

			<MobileMenu locale={locale} items={navItems} />
		</div>
	</div>
</header>

<script>
	// Marks the section being read. The CSP build forbids inline style mutations, so the
	// header only toggles aria-current and data-direction; CSS draws and animates the marks.
	document.querySelectorAll<HTMLElement>('[data-site-header][data-scroll-spy]').forEach((header) => {
		const nav = header.querySelector<HTMLElement>('[data-nav]');
		const links = [...header.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];
		const order = [...new Set(links.map((link) => link.dataset.navLink ?? ''))];
		const sections = order
			.map((id) => document.getElementById(id))
			.filter((section): section is HTMLElement => section !== null);

		if (sections.length === 0) return;

		let activeId: string | null = null;
		let frame = 0;
		let settleTimer = 0;
		let followingClick = false;

		const setActive = (id: string | null) => {
			if (id === activeId) return;

			const from = activeId ? order.indexOf(activeId) : -1;
			const to = id ? order.indexOf(id) : -1;

			if (nav && from !== -1 && to !== -1) {
				nav.dataset.direction = to > from ? 'forward' : 'backward';
			}

			activeId = id;
			links.forEach((link) => {
				if (link.dataset.navLink === id) {
					link.setAttribute('aria-current', 'location');
				} else {
					link.removeAttribute('aria-current');
				}
			});
		};

		const readActive = () => {
			const scrolledToEnd =
				window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;

			if (scrolledToEnd) return sections.at(-1)?.id ?? null;

			const readingLine = window.innerHeight * 0.35;
			let current: string | null = null;

			sections.forEach((section) => {
				if (section.getBoundingClientRect().top <= readingLine) current = section.id;
			});

			return current;
		};

		const sync = () => {
			frame = 0;
			setActive(readActive());
		};

		const requestSync = () => {
			if (!frame) frame = requestAnimationFrame(sync);
		};

		// A click jumps the mark straight to its target instead of sweeping across
		// every section the smooth scroll passes; spying resumes once scrolling settles.
		const releaseAfterScroll = () => {
			window.clearTimeout(settleTimer);
			settleTimer = window.setTimeout(() => {
				followingClick = false;
				requestSync();
			}, 160);
		};

		links.forEach((link) => {
			link.addEventListener('click', () => {
				const id = link.dataset.navLink;

				if (!id || !link.dataset.scrollTarget || !document.getElementById(id)) return;

				followingClick = true;
				setActive(id);
				releaseAfterScroll();
			});
		});

		window.addEventListener(
			'scroll',
			() => {
				if (followingClick) {
					releaseAfterScroll();
				} else {
					requestSync();
				}
			},
			{ passive: true },
		);
		window.addEventListener('resize', requestSync);
		sync();
	});
</script>

<style>
	/* Shared by every header control; the subcomponents in ./header read them by inheritance. */
	.site-header {
		--nav-hover-tint: color-mix(in oklab, var(--color-ink) 8%, transparent);
		--nav-ease: cubic-bezier(0.2, 0, 0, 1);
		/* Tooltips hang just below the header rule instead of crossing it. */
		--tooltip-offset: 1.25rem;
	}

	.site-header :global(a),
	.site-header :global(button),
	.site-header :global(summary) {
		touch-action: manipulation;
	}
</style>
