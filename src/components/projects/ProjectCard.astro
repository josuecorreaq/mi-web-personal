---
import Icon from '../common/Icon.astro';

interface Metric {
	readonly value: string;
	readonly label: string;
}

interface Project {
	readonly name: string;
	readonly objective: string;
	readonly role: string;
	readonly metrics: readonly Metric[];
	readonly architecture: {
		readonly version: string;
	};
}

interface Labels {
	readonly caseStudy: string;
}

interface Props {
	project: Project;
	labels: Labels;
	index: number;
	href: string;
}

const { project, labels, index, href } = Astro.props;
const revealDelay = Math.min(index * 80, 240);
---

<article class="border border-line bg-canvas p-6 sm:p-8 lg:p-10">
	<div class="flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-xs text-muted">
		<span class="text-accent">{project.architecture.version}</span>
		<span class="size-1 bg-line" aria-hidden="true" />
		<span>{project.role}</span>
	</div>

	<div class="mt-5 grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(18rem,0.7fr)] lg:items-end lg:gap-12">
		<div class="min-w-0">
			<h3
				class="max-w-3xl text-balance font-display text-3xl font-semibold tracking-[-0.035em] sm:text-4xl"
				data-animate-text="words"
				data-animate-delay={revealDelay}
			>
				{project.name}
			</h3>
			<p class="mt-4 max-w-2xl text-pretty leading-7 text-muted" data-animate-text="whole" data-animate-delay={revealDelay + 120}>
				{project.objective}
			</p>
		</div>

		<dl
			class="grid gap-px border border-line bg-line sm:grid-cols-3 lg:grid-cols-1"
			data-animate-reveal="up"
			data-animate-reveal-delay={revealDelay + 140}
		>
			{project.metrics.map((metric) => (
				<div class="grid grid-cols-[5.5rem_1fr] items-center gap-4 bg-surface p-3 sm:block sm:p-4 lg:grid">
					<dt class="order-2 text-xs leading-5 text-muted sm:mt-1 lg:mt-0">{metric.label}</dt>
					<dd class="order-1 font-display text-2xl font-semibold tabular-nums tracking-[-0.03em] text-accent">
						{metric.value}
					</dd>
				</div>
			))}
		</dl>
	</div>

	<a
		href={href}
		class="mt-6 inline-flex min-h-11 items-center gap-2 border border-accent bg-accent px-4 py-2 font-mono text-xs font-semibold text-canvas transition-colors hover:bg-accent-hover focus-visible:outline-offset-4"
		aria-label={`${labels.caseStudy}: ${project.name}`}
	>
		{labels.caseStudy}
		<Icon name="arrow-up-right" class="size-4" />
	</a>
</article>