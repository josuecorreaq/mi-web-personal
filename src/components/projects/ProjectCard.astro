---
import Icon from '../common/Icon.astro';

interface Metric {
	readonly value: string;
	readonly label: string;
}

interface ApiSample {
	readonly label: string;
	readonly caption: string;
	readonly rows: readonly string[];
}

interface Project {
	readonly name: string;
	readonly objective: string;
	readonly context: string;
	readonly solution: string;
	readonly role: string;
	readonly decision: string;
	readonly metrics: readonly Metric[];
	readonly evidence: readonly string[];
	readonly apiSample?: ApiSample;
	readonly architecture: {
		readonly version: string;
		readonly layers: readonly string[];
	};
}

interface Labels {
	readonly context: string;
	readonly solution: string;
	readonly role: string;
	readonly decision: string;
	readonly evidence: string;
	readonly details: string;
}

interface Props {
	project: Project;
	labels: Labels;
	index: number;
}

const { project, labels, index } = Astro.props;
const revealDelay = Math.min(index * 80, 240);
const { architecture } = project;
---

<article class="grid border border-line bg-surface lg:grid-cols-[1fr_0.8fr]">
	<div class="min-w-0 p-6 sm:p-10 lg:p-12">
		<h3 class="max-w-xl font-display text-3xl font-semibold tracking-[-0.035em] sm:text-5xl" data-animate-text="words" data-animate-delay={revealDelay}>
			{project.name}
		</h3>
		<p class="mt-6 max-w-xl text-lg leading-8 text-muted" data-animate-text="whole" data-animate-delay={revealDelay + 120}>{project.objective}</p>

		<dl
			class="mt-10 grid gap-px border border-line bg-line sm:grid-cols-3"
			data-animate-reveal="up"
			data-animate-reveal-delay={revealDelay + 140}
		>
			{project.metrics.map((metric) => (
				<div class="grid content-start gap-1 bg-surface p-4">
					<dt class="order-2 text-xs leading-5 text-muted">{metric.label}</dt>
					<dd class="order-1 font-display text-2xl font-semibold tracking-[-0.03em] text-accent sm:text-3xl">
						{metric.value}
					</dd>
				</div>
			))}
		</dl>

		<div class="mt-10" data-animate-reveal="up" data-animate-reveal-delay={revealDelay + 160}>
			<p class="mb-2 font-mono text-[0.65rem] uppercase tracking-[0.12em] text-accent">{labels.evidence}</p>
			<ul class="grid gap-2.5">
				{project.evidence.map((item) => (
					<li class="flex gap-3 text-sm leading-6 text-muted">
						<span class="mt-2.5 size-1 shrink-0 bg-accent" aria-hidden="true" />
						<span class="text-pretty">{item}</span>
					</li>
				))}
			</ul>
		</div>

		<details class="group mt-10 border border-line bg-canvas">
			<summary
				class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 px-4 py-3 font-mono text-[0.65rem] uppercase tracking-[0.12em] text-muted transition-colors marker:content-none hover:text-accent"
			>
				{labels.details}
				<Icon name="chevron" class="size-4 shrink-0 transition-transform group-open:rotate-180" />
			</summary>

			<div class="border-t border-line p-4 sm:p-6">
				<dl class="grid gap-8 sm:grid-cols-2">
					<div>
						<dt class="mb-2 font-mono text-[0.65rem] uppercase tracking-[0.12em] text-accent">{labels.context}</dt>
						<dd class="text-sm leading-6 text-muted">{project.context}</dd>
					</div>
					<div>
						<dt class="mb-2 font-mono text-[0.65rem] uppercase tracking-[0.12em] text-accent">{labels.solution}</dt>
						<dd class="text-sm leading-6 text-muted">{project.solution}</dd>
					</div>
					<div>
						<dt class="mb-2 font-mono text-[0.65rem] uppercase tracking-[0.12em] text-accent">{labels.role}</dt>
						<dd class="text-sm leading-6 text-muted">{project.role}</dd>
					</div>
					<div>
						<dt class="mb-2 font-mono text-[0.65rem] uppercase tracking-[0.12em] text-accent">{labels.decision}</dt>
						<dd class="text-sm leading-6 text-muted">{project.decision}</dd>
					</div>
				</dl>

				{
					project.apiSample && (
						<figure class="mt-8">
							<figcaption class="mb-2 font-mono text-[0.65rem] uppercase tracking-[0.12em] text-accent">
								{project.apiSample.label}
							</figcaption>
							<pre class="whitespace-pre-wrap break-words border border-line bg-surface p-4 font-mono text-xs leading-6 text-muted"><code>{project.apiSample.rows.join('\n')}</code></pre>
							<p class="mt-3 text-sm leading-6 text-muted">{project.apiSample.caption}</p>
						</figure>
					)
				}
			</div>
		</details>
	</div>

	<div
		class="relative min-h-80 overflow-hidden border-t border-line bg-canvas p-6 lg:min-h-full lg:border-l lg:border-t-0"
		data-animate-reveal="right"
		data-animate-reveal-delay="120"
	>
		<div class="relative flex h-full min-h-72 flex-col gap-4 border border-line bg-surface/90 p-5">
			<p class="font-mono text-[0.6rem] uppercase tracking-[0.12em] text-muted">{architecture.version}</p>

			<div class="grid flex-1 content-center gap-3">
				{architecture.layers.map((layer, layerIndex) => (
					<div
						class:list={[
							'border p-3 font-mono text-xs',
							layerIndex % 2 === 0
								? 'w-4/5 border-line bg-canvas text-ink'
								: 'ml-auto w-4/5 border-accent/60 bg-accent/5 text-accent',
						]}
					>
						{layer}
					</div>
				))}
			</div>
		</div>
	</div>
</article>
