---
interface Project {
	readonly name: string;
	readonly objective: string;
	readonly context: string;
	readonly solution: string;
	readonly role: string;
	readonly decision: string;
	readonly evidence: string;
	readonly architecture: {
		readonly title: string;
		readonly version: string;
		readonly layers: readonly string[];
	};
}

interface Labels {
	readonly context: string;
	readonly solution: string;
	readonly role: string;
	readonly decision: string;
	readonly evidence: string;
}

interface Props {
	project: Project;
	labels: Labels;
	index: number;
}

const { project, labels, index } = Astro.props;
const revealDelay = Math.min(index * 80, 240);
const { architecture } = project;
---

<article class="grid border border-line bg-surface lg:grid-cols-[1fr_0.8fr]">
	<div class="p-6 sm:p-10 lg:p-12">
		<h3 class="max-w-xl font-display text-3xl font-semibold tracking-[-0.035em] sm:text-5xl" data-animate-text="words" data-animate-delay={revealDelay}>
			{project.name}
		</h3>
		<p class="mt-6 max-w-xl text-lg leading-8 text-muted" data-animate-text="whole" data-animate-delay={revealDelay + 120}>{project.objective}</p>

		<dl class="mt-10 grid gap-8 sm:grid-cols-2" data-animate-reveal="up" data-animate-reveal-delay={revealDelay + 160}>
			<div>
				<dt class="mb-2 font-mono text-[0.65rem] uppercase tracking-[0.12em] text-accent">{labels.context}</dt>
				<dd class="text-sm leading-6 text-muted">{project.context}</dd>
			</div>
			<div>
				<dt class="mb-2 font-mono text-[0.65rem] uppercase tracking-[0.12em] text-accent">{labels.solution}</dt>
				<dd class="text-sm leading-6 text-muted">{project.solution}</dd>
			</div>
			<div>
				<dt class="mb-2 font-mono text-[0.65rem] uppercase tracking-[0.12em] text-accent">{labels.role}</dt>
				<dd class="text-sm leading-6 text-muted">{project.role}</dd>
			</div>
			<div>
				<dt class="mb-2 font-mono text-[0.65rem] uppercase tracking-[0.12em] text-accent">{labels.decision}</dt>
				<dd class="text-sm leading-6 text-muted">{project.decision}</dd>
			</div>
			<div class="sm:col-span-2">
				<dt class="mb-2 font-mono text-[0.65rem] uppercase tracking-[0.12em] text-accent">{labels.evidence}</dt>
				<dd class="text-sm leading-6 text-muted">{project.evidence}</dd>
			</div>
		</dl>
	</div>

	<div
		class="relative min-h-80 overflow-hidden border-t border-line bg-canvas p-6 lg:min-h-full lg:border-l lg:border-t-0"
		data-animate-reveal="right"
		data-animate-reveal-delay="120"
	>
		<div class="relative flex h-full min-h-72 flex-col border border-line bg-surface/90 p-5">
			<div class="flex items-center justify-between font-mono text-[0.6rem] uppercase tracking-[0.12em] text-muted">
				<span>{architecture.title}</span>
				<span>{architecture.version}</span>
			</div>

			<div class="grid flex-1 content-center gap-3">
				{architecture.layers.map((layer, layerIndex) => (
					<div
						class:list={[
							'border p-3 font-mono text-xs',
							layerIndex % 2 === 0
								? 'w-4/5 border-line bg-canvas text-ink'
								: 'ml-auto w-4/5 border-accent/60 bg-accent/5 text-accent',
						]}
					>
						{layer}
					</div>
				))}
			</div>
		</div>
	</div>
</article>
