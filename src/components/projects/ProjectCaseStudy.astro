---
import ArrowLeft from '@lucide/astro/icons/arrow-left';
import Icon from '../common/Icon.astro';
import { getLocalePath, type Locale } from '../../i18n/config';
import {
	getNextProject,
	projectPageCopy,
	type Project,
} from '../../data/projects';

interface Props {
	locale: Locale;
	project: Project;
}

const { locale, project } = Astro.props;
const copy = projectPageCopy[locale];
const homePath = getLocalePath(locale);
const nextProject = getNextProject(locale, project.id);
---

<article>
	<header class="border-b border-line bg-canvas">
		<div class="page-shell py-10 sm:py-14 lg:py-16">
			<a
				href={`${homePath}#proyectos`}
				class="inline-flex min-h-11 items-center gap-2 font-mono text-xs text-muted transition-colors hover:text-accent"
			>
				<ArrowLeft class="size-4" aria-hidden="true" stroke-width={1.8} />
				{copy.back}
			</a>

			<div class="mt-6 grid gap-8 lg:grid-cols-[minmax(0,1.35fr)_minmax(16rem,0.65fr)] lg:items-center lg:gap-10">
				<div class="min-w-0">
					<p class="section-kicker" data-animate-text="whole">{copy.kicker}</p>
					<h1
						class="max-w-4xl text-balance font-display text-[clamp(2.6rem,7vw,5.75rem)] font-semibold leading-[0.95] tracking-[-0.04em]"
						data-animate-text="words"
						data-animate-delay="80"
					>
						{project.name}
					</h1>
					<p class="mt-7 max-w-3xl text-pretty text-lg leading-8 text-muted sm:text-xl">
						{project.objective}
					</p>
				</div>

				<dl class="grid self-center border border-line bg-line" data-animate-reveal="up">
					<div class="grid grid-cols-[6.5rem_1fr] items-center gap-4 bg-surface p-4">
						<dt class="font-mono text-xs text-muted">{copy.status}</dt>
						<dd class="text-sm font-semibold text-ink">{project.architecture.version}</dd>
					</div>
					<div class="mt-px grid grid-cols-[6.5rem_1fr] items-center gap-4 bg-surface p-4">
						<dt class="font-mono text-xs text-muted">{copy.role}</dt>
						<dd class="text-sm font-semibold text-ink">{project.role}</dd>
					</div>
					<div class="mt-px grid grid-cols-[6.5rem_1fr] items-center gap-4 bg-surface p-4">
						<dt class="font-mono text-xs text-muted">{copy.stack}</dt>
						<dd class="text-sm font-semibold leading-6 text-ink">{project.stack.join(' · ')}</dd>
					</div>
				</dl>
			</div>

			<dl class="mt-10 grid gap-px border border-line bg-line sm:grid-cols-3" data-animate-reveal="up">
				{project.metrics.map((metric) => (
					<div class="grid content-start gap-2 bg-surface p-5 sm:p-6">
						<dt class="order-2 max-w-48 text-pretty text-sm leading-6 text-muted">{metric.label}</dt>
						<dd class="order-1 font-display text-3xl font-semibold tabular-nums tracking-[-0.04em] text-accent sm:text-4xl">
							{metric.value}
						</dd>
					</div>
				))}
			</dl>
		</div>
	</header>

	<section class="border-b border-line bg-canvas" aria-labelledby="project-context">
		<div class="page-shell grid gap-8 py-14 sm:py-16 lg:grid-cols-[minmax(12rem,0.45fr)_minmax(0,1fr)] lg:items-center lg:gap-20">
			<h2 id="project-context" class="font-display text-2xl font-semibold tracking-[-0.035em] sm:text-3xl">
				{copy.context}
			</h2>
			<p class="max-w-3xl text-pretty text-lg leading-8 text-muted" data-animate-reveal="up">
				{project.context}
			</p>
		</div>
	</section>

	<section class="border-b border-line bg-canvas" aria-labelledby="project-solution">
		<div class="page-shell grid gap-8 py-14 sm:py-16 lg:grid-cols-[minmax(12rem,0.45fr)_minmax(0,1fr)] lg:items-center lg:gap-20">
			<h2 id="project-solution" class="font-display text-2xl font-semibold tracking-[-0.035em] sm:text-3xl">
				{copy.solution}
			</h2>
			<div class="grid gap-10">
				<p class="max-w-3xl text-pretty text-lg leading-8 text-muted" data-animate-reveal="up">
					{project.solution}
				</p>
				<div class="border border-line bg-surface p-6 sm:p-8" data-animate-reveal="up">
					<h3 class="font-mono text-xs font-semibold uppercase tracking-[0.12em] text-accent">{copy.decision}</h3>
					<p class="mt-4 max-w-3xl text-pretty leading-7 text-ink">{project.decision}</p>
				</div>
			</div>
		</div>
	</section>

	<section class="border-b border-line bg-canvas" aria-labelledby="project-architecture">
		<div class="page-shell py-16 sm:py-20">
			<div class="grid gap-8 lg:grid-cols-[minmax(0,0.7fr)_minmax(0,1.3fr)] lg:items-center lg:gap-16">
				<div>
					<h2 id="project-architecture" class="section-title text-[clamp(2.25rem,5vw,3.5rem)]">
						{copy.architecture}
					</h2>
					<p class="mt-6 max-w-xl text-pretty leading-7 text-muted">{copy.architectureCopy}</p>
				</div>

				<ol class="grid gap-3 border border-line bg-transparent p-4 sm:p-6" data-animate-reveal="right">
					{project.architecture.layers.map((layer) => (
						<li class="grid min-h-16 grid-cols-[1rem_1fr] items-center gap-4 border border-line bg-surface px-4 py-3">
							<span class="size-2 justify-self-center bg-accent" aria-hidden="true" />
							<span class="font-mono text-sm text-ink">{layer}</span>
						</li>
					))}
				</ol>
			</div>
		</div>
	</section>

	<section class="border-b border-line bg-canvas" aria-labelledby="project-evidence">
		<div class="page-shell py-16 sm:py-20">
			<div class="grid gap-8 lg:grid-cols-[minmax(12rem,0.45fr)_minmax(0,1fr)] lg:items-center lg:gap-20">
				<h2 id="project-evidence" class="font-display text-2xl font-semibold tracking-[-0.035em] sm:text-3xl">
					{copy.evidence}
				</h2>
				<div class="grid gap-8">
					<ul class="grid border-y border-line">
						{project.evidence.map((item) => (
							<li class="grid min-h-20 grid-cols-[1rem_1fr] items-center gap-4 border-b border-line py-5 last:border-b-0">
								<span class="size-2 justify-self-center bg-accent" aria-hidden="true" />
								<span class="max-w-3xl text-pretty leading-7 text-muted">{item}</span>
							</li>
						))}
					</ul>

					{project.apiSample && (
						<figure>
							<figcaption class="font-mono text-xs font-semibold uppercase tracking-[0.12em] text-accent">
								{copy.api}
							</figcaption>
							<pre class="mt-4 max-w-full overflow-x-auto border border-line bg-surface p-5 font-mono text-xs leading-6 text-muted"><code>{project.apiSample.rows.join('\n')}</code></pre>
							<p class="mt-4 max-w-3xl text-pretty text-sm leading-6 text-muted">{project.apiSample.caption}</p>
						</figure>
					)}
				</div>
			</div>
		</div>
	</section>

	<section class="border-b border-line bg-canvas" aria-labelledby="project-result">
		<div class="page-shell grid gap-8 py-14 sm:py-16 lg:grid-cols-[minmax(12rem,0.45fr)_minmax(0,1fr)] lg:items-center lg:gap-20">
			<h2 id="project-result" class="font-display text-2xl font-semibold tracking-[-0.035em] sm:text-3xl">{copy.result}</h2>
			<p class="max-w-3xl text-pretty text-lg leading-8 text-muted">{copy.resultCopy}</p>
		</div>
	</section>

	<nav class="border-b border-line bg-canvas" aria-label={copy.next}>
		<div class="page-shell py-12 sm:py-16">
			<p class="font-mono text-xs text-muted">{copy.next}</p>
			<a
				href={nextProject.path}
				class="mt-4 flex min-h-16 items-center justify-between gap-6 border-y border-line py-4 font-display text-xl font-semibold text-ink transition-colors hover:text-accent sm:text-2xl"
			>
				<span class="text-balance">{nextProject.name}</span>
				<Icon name="arrow-up-right" class="size-5 shrink-0" />
			</a>
		</div>
	</nav>

	<section class="bg-canvas" aria-labelledby="project-contact">
		<div class="page-shell section-shell text-center">
			<h2 id="project-contact" class="mx-auto max-w-3xl text-balance font-display text-3xl font-semibold tracking-[-0.04em] sm:text-5xl">
				{copy.contact}
			</h2>
			<p class="mx-auto mt-5 max-w-2xl text-pretty leading-7 text-muted">{copy.contactCopy}</p>
			<a
				href={`${homePath}#contacto`}
				class="mt-8 inline-flex min-h-11 items-center gap-2 border border-accent bg-accent px-5 py-3 font-mono text-xs font-semibold text-canvas transition-colors hover:bg-accent-hover"
			>
				{copy.contactAction}
				<Icon name="arrow-up-right" class="size-4" />
			</a>
		</div>
	</section>
</article>