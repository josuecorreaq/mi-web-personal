---

interface Props {
	name: string;
	items: readonly { readonly question: string; readonly answer: string }[];
	class?: string;
}

const { name, items, class: className } = Astro.props;
---

<div class:list={['border-t border-line', className]}>
	{items.map((item, index) => (
		<details
			class="faq-item group border-b border-line"
			name={name}
			data-animate-reveal="up"
			data-animate-reveal-delay={index * 70}
		>
			<summary class="flex min-h-18 items-center justify-between gap-6 py-4">
				<h3 class="text-pretty font-display text-[clamp(1.125rem,1.8vw,1.375rem)] font-heading leading-snug tracking-[-0.01em] transition-colors group-hover:text-accent">
					{item.question}
				</h3>
				<svg
					class="faq-toggle size-9 shrink-0"
					viewBox="0 0 36 36"
					fill="none"
					stroke="currentColor"
					stroke-width="1.25"
					stroke-linecap="square"
					aria-hidden="true"
				>
					<path class="faq-toggle-corners" d="M1 7V1h6M29 1h6v6M35 29v6h-6M7 35H1v-6" />
					<path d="M13 18h10" />
					<path class="faq-toggle-bar" d="M18 13v10" />
				</svg>
			</summary>
			<p class="faq-answer max-w-[38em] pb-6 text-pretty leading-relaxed text-muted">{item.answer}</p>
		</details>
	))}
</div>

<script>
	// Rows open and close by easing their height instead of jumping. Without script (or with reduced motion)
	// the native details and its shared `name` keep working, so this only takes over when it can animate.
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
	const items = Array.from(document.querySelectorAll<HTMLDetailsElement>('details.faq-item'));
	const running = new WeakMap<HTMLDetailsElement, Animation>();

	if (!reduceMotion.matches && 'animate' in Element.prototype) {
		// The shared `name` would close the other rows at once; the script closes them with the same easing.
		items.forEach((item) => {
			item.dataset.faqGroup = item.name;
			item.removeAttribute('name');
		});

		const animateTo = (item: HTMLDetailsElement, open: boolean) => {
			const summary = item.querySelector('summary');
			if (!summary) return;

			const startHeight = item.offsetHeight;
			running.get(item)?.cancel();

			if (open) {
				delete item.dataset.closing;
				item.open = true;
			} else {
				item.dataset.closing = '';
			}

			const borders = item.offsetHeight - item.clientHeight;
			const endHeight = open ? item.offsetHeight : summary.offsetHeight + borders;

			item.dataset.animating = '';
			const animation = item.animate(
				{ height: [`${startHeight}px`, `${endHeight}px`] },
				{ duration: 320, easing: 'cubic-bezier(0.25, 1, 0.5, 1)' },
			);
			running.set(item, animation);

			animation.addEventListener('finish', () => {
				if (!open) {
					item.open = false;
					delete item.dataset.closing;
				}
				delete item.dataset.animating;
				running.delete(item);
			});
		};

		items.forEach((item) => {
			item.querySelector('summary')?.addEventListener('click', (event) => {
				event.preventDefault();
				const opening = !item.open || item.dataset.closing !== undefined;

				if (opening) {
					items
						.filter(
							(other) =>
								other !== item &&
								other.dataset.faqGroup === item.dataset.faqGroup &&
								other.open &&
								other.dataset.closing === undefined,
						)
						.forEach((other) => animateTo(other, false));
				}

				animateTo(item, opening);
			});
		});
	}
</script>

<style>
	.faq-item summary {
		list-style: none;
	}

	.faq-item summary::-webkit-details-marker {
		display: none;
	}

	.faq-item[data-animating] {
		overflow: hidden;
	}

	.faq-toggle-corners {
		color: var(--color-field);
	}

	.faq-item summary:hover .faq-toggle-corners,
	.faq-item[open]:not([data-closing]) .faq-toggle-corners {
		color: var(--color-accent);
	}

	.faq-toggle-bar {
		transform-box: fill-box;
		transform-origin: center;
	}

	.faq-item[open]:not([data-closing]) .faq-toggle-bar {
		transform: rotate(90deg);
	}

	@media (prefers-reduced-motion: no-preference) {
		.faq-toggle-corners {
			transition: color 160ms ease;
		}

		.faq-toggle-bar {
			transition: transform 240ms var(--ease-out-quart);
		}

		.faq-item[open] .faq-answer {
			animation: faq-answer-in 320ms var(--ease-out-quart);
		}

		.faq-item[data-closing] .faq-answer {
			opacity: 0;
			transform: translateY(-0.25rem);
			transition:
				opacity 180ms ease,
				transform 220ms ease;
		}
	}

	@keyframes faq-answer-in {
		from {
			opacity: 0;
			transform: translateY(-0.25rem);
		}
	}
</style>
