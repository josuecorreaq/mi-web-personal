---
import ActionLink from '../common/ActionLink.astro';
import BulletList from '../common/BulletList.astro';
import ContactBand from '../common/ContactBand.astro';
import FactList from '../common/FactList.astro';
import LinkRow from '../common/LinkRow.astro';
import FaqList from './FaqList.astro';
import ProcessFigure from './ProcessFigure.astro';
import { getProjects } from '../../data/projects';
import { getLocalePath, type Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/translations';
import { detailRow, monoLabel } from '../../styles/classes';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale).services;
const contactHref = `${getLocalePath(locale)}#contacto`;
const projects = getProjects(locale);
const listTitleOffset = {
	reach: 'min-[58rem]:pt-4',
	evidence: 'min-[58rem]:pt-2',
	faq: 'min-[58rem]:pt-5',
};
---

<article>
	<header class="page-shell pb-section pt-[clamp(1.5rem,4vw,3rem)]">
		<p class={monoLabel}>{t.label}</p>
		<h1 class="ml-(--optical-inset) mt-4.5 max-w-[16em] text-balance type-page-title" data-animate-text="words">
			{t.hero.title}
		</h1>
		<p
			class="mt-[clamp(0.75rem,2vw,1.25rem)] max-w-[32em] text-pretty type-lead text-muted"
			data-animate-reveal="up"
			data-animate-reveal-delay="200"
		>
			{t.hero.lead}
		</p>

		<div
			class="mt-block flex flex-wrap items-end justify-between gap-x-16 gap-y-5"
			data-animate-reveal="up"
			data-animate-reveal-delay="300"
		>
			<ActionLink href={contactHref}>{t.hero.cta}</ActionLink>
			<FactList facts={t.hero.facts} />
		</div>
	</header>

	<section class="page-shell border-t border-line py-section">
		{t.offer.items.map((service, index) => (
			<div class:list={[detailRow.row, index === 0 ? 'pb-block' : 'border-t border-line pt-block']}>
				<h2 id={service.id} class={detailRow.title}>{service.name}</h2>
				<div class={detailRow.body}>
					<p class={detailRow.prose} data-animate-reveal="up">{service.description}</p>
					<BulletList items={service.points} class="mt-6" />
				</div>
			</div>
		))}
	</section>

	<section class="page-shell border-t border-line py-section" aria-labelledby="services-process">
		<div class={detailRow.row}>
			<h2 id="services-process" class={detailRow.title}>{t.process.title}</h2>
			<ProcessFigure
				label={t.process.label}
				stagesLabel={t.process.stages}
				caption={t.process.caption}
				steps={t.process.steps}
				class={detailRow.body}
			/>
		</div>
	</section>

	<section class="page-shell border-t border-line py-section" aria-labelledby="services-reach">
		<div class={detailRow.row}>
			<h2 id="services-reach" class:list={[detailRow.title, listTitleOffset.reach]}>{t.reach.title}</h2>
			<dl class:list={[detailRow.body, 'border-t border-line']}>
				{t.reach.items.map((item, index) => (
					<div
						class="flex flex-wrap gap-x-8 gap-y-1 border-b border-line py-5"
						data-animate-reveal="up"
						data-animate-reveal-delay={index * 80}
					>
						<dt class="w-36 shrink-0 pt-[0.15rem] font-mono text-[0.8125rem]">{item.label}</dt>
						<dd class="min-w-0 flex-[1_1_18rem] text-pretty leading-relaxed text-muted">{item.value}</dd>
					</div>
				))}
			</dl>
		</div>
	</section>

	<section class="page-shell border-t border-line py-section" aria-labelledby="services-evidence">
		<div class={detailRow.row}>
			<h2 id="services-evidence" class:list={[detailRow.title, listTitleOffset.evidence]}>{t.evidence.title}</h2>
			<ul class:list={[detailRow.body, 'border-t border-line']}>
				{projects.map((project) => {
					const [metric] = project.metrics;

					return (
						<li>
							<LinkRow
								href={project.path}
								eyebrow={`${metric.value} · ${metric.label}`}
								title={project.name}
								projectPath={project.path}
								class="border-b border-line"
							/>
						</li>
					);
				})}
			</ul>
		</div>
	</section>

	<section class="page-shell border-t border-line py-section" aria-labelledby="services-faq">
		<div class={detailRow.row}>
			<h2 id="services-faq" class:list={[detailRow.title, listTitleOffset.faq]}>{t.faq.title}</h2>
			<FaqList name="services-faq" items={t.faq.items} class={detailRow.body} />
		</div>
	</section>

	<ContactBand id="services-contact" title={t.cta.title} copy={t.cta.copy} action={t.cta.action} href={contactHref} />
</article>
