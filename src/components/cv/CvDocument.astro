---
import type { Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/translations';
import Icon from '../common/Icon.astro';
import MetaList from '../common/MetaList.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const cv = useTranslations(locale).cv;
const contacts = [
	{ icon: 'email', label: cv.email, href: `mailto:${cv.email}`, external: false },
	{ icon: 'linkedin', label: cv.linkedin.replace('linkedin.com/', ''), href: `https://www.${cv.linkedin}`, external: true },
	{ icon: 'github', label: `@${cv.github.replace('github.com/', '')}`, href: `https://${cv.github}`, external: true },
] as const;
const sectionTitleClass =
	'border-t border-line pt-6 font-display text-xl font-heading leading-tight tracking-[-0.015em] text-ink';
const periodClass = 'font-mono text-[0.78rem] text-muted';
---

<article class="grid gap-10">
	<header>
		<h2 class="text-balance font-display text-[clamp(1.75rem,3vw,2.25rem)] font-heading leading-[1.1] tracking-[-0.025em] text-ink">
			{cv.name}
		</h2>
		<MetaList items={cv.role.split(' · ')} class="mt-2.5 text-base text-muted" />

		<p class="mt-5 inline-flex items-center gap-2 font-mono text-[0.8125rem] text-muted">
			<Icon name="location" class="size-4 shrink-0 text-accent" />
			{cv.location}
		</p>
		<ul class="mt-2.5 flex flex-wrap gap-x-6 gap-y-2.5 font-mono text-[0.8125rem]">
			{contacts.map((contact) => (
				<li>
					<a
						class="inline-flex min-h-6 items-center gap-2 text-ink underline-offset-4 transition-colors hover:text-accent hover:underline"
						href={contact.href}
						target={contact.external ? '_blank' : undefined}
						rel={contact.external ? 'noopener noreferrer' : undefined}
					>
						<Icon name={contact.icon} class="size-4 shrink-0 text-accent" />
						<span class="break-all">{contact.label}</span>
					</a>
				</li>
			))}
		</ul>

		<p class="mt-6 max-w-[42em] text-pretty text-[0.9375rem] leading-[1.7] text-muted">{cv.summary}</p>
	</header>

	<section>
		<h3 class={sectionTitleClass}>{cv.sections.experience}</h3>
		<div class="mt-5 grid gap-8">
			{cv.experience.map((entry) => (
				<div>
					<div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
						<h4 class="font-display text-lg font-heading leading-snug text-ink">{entry.role}</h4>
						<p class={periodClass}>{entry.period}</p>
					</div>
					<MetaList items={[entry.organization, entry.location]} class="mt-1.5 text-[0.9375rem] text-muted" />
					<ul class="mt-4 grid gap-2.5">
						{entry.bullets.map((bullet) => (
							<li class="flex gap-3.5 text-pretty text-[0.9375rem] leading-[1.65] text-ink">
								<span class="mt-[0.6rem] size-[5px] shrink-0 bg-accent" aria-hidden="true"></span>
								{bullet}
							</li>
						))}
					</ul>
				</div>
			))}
		</div>
	</section>

	<section>
		<h3 class={sectionTitleClass}>{cv.sections.education}</h3>
		<ul class="mt-5 grid gap-5">
			{cv.education.map((entry) => (
				<li>
					<div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
						<p class="text-[0.9375rem] font-medium text-ink">{entry.degree}</p>
						<p class={periodClass}>{entry.period}</p>
					</div>
					<MetaList items={[entry.institution, entry.location]} class="mt-1.5 text-[0.9375rem] text-muted" />
				</li>
			))}
		</ul>
		<p class="mt-4 text-sm text-muted">{cv.educationNote}</p>
	</section>

	<section>
		<h3 class={sectionTitleClass}>{cv.sections.skills}</h3>
		<dl class="mt-5 grid gap-4">
			{cv.skills.map((skill) => (
				<div class="grid gap-1 sm:grid-cols-[13.5rem_minmax(0,1fr)] sm:gap-6">
					<dt class="font-mono text-[0.78rem] leading-6 text-muted">{skill.label}</dt>
					<dd class="text-pretty text-[0.9375rem] leading-6 text-ink">{skill.value}</dd>
				</div>
			))}
		</dl>
	</section>

	<div class="grid gap-10 sm:grid-cols-2">
		<section>
			<h3 class={sectionTitleClass}>{cv.sections.languages}</h3>
			<dl class="mt-4">
				{cv.languages.map((language) => (
					<div class="flex items-baseline justify-between gap-4 border-b border-line py-3 text-[0.9375rem]">
						<dt class="text-ink">{language.label}</dt>
						<dd class="font-mono text-[0.78rem] text-muted">{language.value}</dd>
					</div>
				))}
			</dl>
		</section>

		<section>
			<h3 class={sectionTitleClass}>{cv.sections.competencies}</h3>
			<ul class="mt-4">
				{cv.competencies.map((competency) => (
					<li class="flex items-center gap-3.5 border-b border-line py-3 text-pretty text-[0.9375rem] text-ink">
						<span class="size-[5px] shrink-0 bg-accent" aria-hidden="true"></span>
						{competency}
					</li>
				))}
			</ul>
		</section>
	</div>
</article>
