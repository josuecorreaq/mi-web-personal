ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteCond %{HTTPS} !=on [OR]
	RewriteCond %{HTTP_HOST} ^www\.josuecorreaq\.com$ [NC]
	RewriteRule ^ https://josuecorreaq.com%{REQUEST_URI} [R=301,L,NE]

	# La versión española vivía en /es/; hoy su URL canónica es /. El HTML antiguo puede seguir
	# en el servidor (el despliegue copia sin borrar), así que se redirige todo /es/ a la portada.
	RewriteRule ^es(?:/.*)?$ / [R=301,L]

	# /index.html y /en/index.html tienen el mismo contenido que su directorio.
	# Se redirige a la URL canonica para no dejar duplicados indexables.
	RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
	RewriteRule ^(.*/)?index\.html$ /%1 [R=301,L,NE]
</IfModule>

<IfModule mod_expires.c>
	ExpiresActive On
	ExpiresByType text/html "access plus 0 seconds"
	ExpiresByType font/woff2 "access plus 1 year"
	ExpiresByType image/webp "access plus 30 days"
	ExpiresByType image/png "access plus 30 days"
	ExpiresByType image/svg+xml "access plus 30 days"
	ExpiresByType image/x-icon "access plus 30 days"
	ExpiresByType application/manifest+json "access plus 1 day"
	ExpiresByType application/xml "access plus 1 day"
	ExpiresByType text/plain "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
	Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
	Header always set Content-Security-Policy "default-src 'none'; script-src 'self' 'sha256-+NUn8lGkQ1yRAxeXzBE4r2y0FzwRpXhB3IVUvM4WchQ=' 'sha256-1DGEibYUvxzIb0eeErDQBSZm63G6vj5O/bVosj9bw5Y=' 'sha256-8SjRMEqwPKeD7AG4VNhO04Cd5faOFP0OegqFt8ZP2G0=' 'sha256-9s4tz0DJ+5toxUMy2LgzUkzHAhznnTLTYTTnw9tjDaM=' 'sha256-AzmL5m1/DCaWXgBdZWFnMIeWSer3Lf6W7BszoyblKdg=' 'sha256-D6SS9BezFe18rQJ5QWC8dPqjpQvymhNwc5vMCzJd+zs=' 'sha256-ERogwm3tgxFO+Qzlr8YySaSSUT8JR/C90+5afMzJI7A=' 'sha256-HDOhtMmBWaQbZ8hjGR2RlAI+73+m9Yp03W99Dl5sdKI=' 'sha256-HkRrAmXM154RjjjalAA+Y4Lg2C1zfc4rsQR6cTnEbLc=' 'sha256-Kh7nzKHwtv6Ucgkrf7OBxL0gsiXc0uUQjqm3d1iJNbk=' 'sha256-OhN+jT7naIAewFZ24Xu00IiiSkmFVH7WVItJhIug5Ss=' 'sha256-Tp0nQB5OSEzRwVt2BVAMhM+oRfwoxY9JcC2jVnlY+aI=' 'sha256-ZPJ3aAtUsbHUna/6hdVuJOR8zWlf6a4cagw7DTK88qA=' 'sha256-flDic7sDOAI81tiCzYynFB1my6+cwuFmflfUvfC9xdg=' 'sha256-gphD0UvkCQ/1CsBCeWDvoFCTeBgbNsS48BJkPLQPkiU=' 'sha256-hcRBwctlAlL64S+RO8aaZPrACK+48WlSFy/TkTVMACw=' 'sha256-iwNF7mm21wsqcn6jBwOxGiMk5IkuuZGUeI7x+G2jY/0=' 'sha256-kNtGhdV068zmfj+wWLhB/RESAnA2TyEmXuYoiq3q0C8=' 'sha256-km7d9j4LTmstuuYF1hrhHvflWwlINdII3O8sR/JHqas=' 'sha256-nKF3nWDckaTrg2TYMBtJqaR95fLFmPtsSvuUaqSBJHg=' 'sha256-oFr3Whuquss0pbbHIn3BM2R4BiiMwOlZxlNAeBjv/9Y=' 'sha256-ozC4mB0hm3+rAiaCsJ299OW2bSy8Qeu1iZ9joW084Go=' 'sha256-v2Mi/YxSl8ZBczc7JuhIgFXL3s0m52RqgxzHC6dntWA=' 'sha256-xqVvwVBUJlOY3cD5Z35hfeAHQ6sXJ61IV9Tad68NEX4=' https://challenges.cloudflare.com; script-src-attr 'none'; style-src 'self' 'sha256-VPavnKAYT0LugDyTpLW9c2OlDTL2Lg8Ynd+JT5iYDYA=' 'sha256-d6UHteVT5k0HY6DWecoWB7ITcTyNVZoJhmSdZJlBrwo=' 'sha256-l6bAE7zlZA1Wx2lOPYQzjX2hV3VZzvMPjYNOaXcII2I=' 'sha256-qtHggZlaOktUScYQKAaw00VrGFAsB03bR5n5WSsNElA='; style-src-attr 'none'; img-src 'self' data:; font-src 'self'; manifest-src 'self'; connect-src 'self' https://api.josuecorreaq.com https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; form-action 'self' https://api.josuecorreaq.com; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
	Header always set X-Content-Type-Options "nosniff"
	Header always set X-Frame-Options "DENY"
	Header always set Referrer-Policy "strict-origin-when-cross-origin"
	Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

	# HTML: revalidar siempre. Evita servir una versión vieja tras un deploy.
	<FilesMatch "\.html$">
		Header set Cache-Control "no-cache"
	</FilesMatch>
	# Fuentes: nombre y contenido estables, se pueden cachear indefinidamente.
	<FilesMatch "\.woff2$">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</FilesMatch>
	# Imágenes e iconos: el nombre no lleva hash, 30 días para poder reemplazarlos.
	<FilesMatch "\.(webp|png|svg|ico)$">
		Header set Cache-Control "public, max-age=2592000"
	</FilesMatch>
	<FilesMatch "\.(webmanifest|xml|txt)$">
		Header set Cache-Control "public, max-age=86400"
	</FilesMatch>
	# CSS y JS del build: el nombre lleva el hash del contenido y cada deploy apunta a nombres nuevos.
	<If "%{REQUEST_URI} =~ m#^/_astro/#">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</If>
	# Fragmentos que la página carga por fetch (el CV del diálogo): no son páginas propias.
	<If "%{REQUEST_URI} =~ m#^/partials/#">
		Header set X-Robots-Tag "noindex"
	</If>
</IfModule>
