ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteCond %{HTTPS} !=on [OR]
	RewriteCond %{HTTP_HOST} ^www\.josuecorreaq\.com$ [NC]
	RewriteRule ^ https://josuecorreaq.com%{REQUEST_URI} [R=301,L,NE]

	# /index.html y /en/index.html tienen el mismo contenido que su directorio.
	# Se redirige a la URL canonica para no dejar duplicados indexables.
	RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
	RewriteRule ^(.*/)?index\.html$ /%1 [R=301,L,NE]
</IfModule>

<IfModule mod_expires.c>
	ExpiresActive On
	ExpiresByType text/html "access plus 0 seconds"
	ExpiresByType font/woff2 "access plus 1 year"
	ExpiresByType image/webp "access plus 30 days"
	ExpiresByType image/png "access plus 30 days"
	ExpiresByType image/svg+xml "access plus 30 days"
	ExpiresByType image/x-icon "access plus 30 days"
	ExpiresByType application/manifest+json "access plus 1 day"
	ExpiresByType application/xml "access plus 1 day"
	ExpiresByType text/plain "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
	Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
	Header always set Content-Security-Policy "default-src 'none'; script-src 'self' 'sha256-0fVtjmRiVRA2QM+UxCXqKrM5UjFIEhER1fq6Jsiasx4=' 'sha256-3jRRTnCBCWObb2JxR1rXx+B9B1s1aPJ4zE0oP0Kzh2c=' 'sha256-49DDlT60lC/dLGAZ48kGmN2jd3MQROG1gODaLwOOxHk=' 'sha256-849VB5oqvgGMs+l2K/DZ1ZhWQt581m2+CQecgL/h4/g=' 'sha256-GhXLjZiMbHjeW+6CSVpiffYEWbKQMQzTpqXVjwhQnZI=' 'sha256-H86cikW5TRUj6vSxFHW00itbeoXHH/OE/Xss5tOvKlI=' 'sha256-SAN+2zkQJswJzKsasQ6qDWJyRGXKNxOOOKhypj9ddWw=' 'sha256-XKNp4xFf5sKnmVMkWkOtduKxUg9KKxzjq3p4a0yKlJY=' 'sha256-awSD6Wx4CQdvBRdNesgLwoJ5Ug6ApB3yksEgznyMwBo=' 'sha256-az/86vpFDSx0UWGTcjIDUsU6oGnTADI66QyYL/GCbTE=' 'sha256-cUFNFcXu5XAu80GTbWk8JfOCeYlssIPOw+NvdgTvE1o=' 'sha256-f1M8hKPQ0c1OTE5YoS/uN/mRdWqZKw+JfZegPM7AGL0=' 'sha256-iwNF7mm21wsqcn6jBwOxGiMk5IkuuZGUeI7x+G2jY/0=' 'sha256-nXCmh+hdZtfleKfU+wJbSZSOAA1GUySo8ToD3KagPfw=' 'sha256-uDyxc3IASLs8xmDYwWCjkN9KAzZRf6F5wepqLARwfDA=' 'sha256-xqVvwVBUJlOY3cD5Z35hfeAHQ6sXJ61IV9Tad68NEX4=' https://challenges.cloudflare.com; script-src-attr 'none'; style-src 'self' 'sha256-Tz5woSqcacLZGde2554c9ZmphZn/gFEdQ1UZGOyrX0g=' 'sha256-ZxKvJCEa6L4HJVuZ6yjuHfkNHWcHkpCrZSL7UX0YQFc='; style-src-attr 'none'; img-src 'self' data:; font-src 'self'; manifest-src 'self'; connect-src 'self' https://api.josuecorreaq.com https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; form-action 'self' https://api.josuecorreaq.com; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
	Header always set X-Content-Type-Options "nosniff"
	Header always set X-Frame-Options "DENY"
	Header always set Referrer-Policy "strict-origin-when-cross-origin"
	Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

	# HTML: revalidar siempre. Evita servir una versión vieja tras un deploy.
	<FilesMatch "\.html$">
		Header set Cache-Control "no-cache"
	</FilesMatch>
	# Fuentes: nombre y contenido estables, se pueden cachear indefinidamente.
	<FilesMatch "\.woff2$">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</FilesMatch>
	# Imágenes e iconos: el nombre no lleva hash, 30 días para poder reemplazarlos.
	<FilesMatch "\.(webp|png|svg|ico)$">
		Header set Cache-Control "public, max-age=2592000"
	</FilesMatch>
	<FilesMatch "\.(webmanifest|xml|txt)$">
		Header set Cache-Control "public, max-age=86400"
	</FilesMatch>
</IfModule>
