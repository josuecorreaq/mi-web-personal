ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteCond %{HTTPS} !=on [OR]
	RewriteCond %{HTTP_HOST} ^www\.josuecorreaq\.com$ [NC]
	RewriteRule ^ https://josuecorreaq.com%{REQUEST_URI} [R=301,L,NE]

	# La versión española vivía en /es/; hoy su URL canónica es /. El HTML antiguo puede seguir
	# en el servidor (el despliegue copia sin borrar), así que se redirige todo /es/ a la portada.
	RewriteRule ^es(?:/.*)?$ / [R=301,L]

	# /index.html y /en/index.html tienen el mismo contenido que su directorio.
	# Se redirige a la URL canonica para no dejar duplicados indexables.
	RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
	RewriteRule ^(.*/)?index\.html$ /%1 [R=301,L,NE]
</IfModule>

<IfModule mod_expires.c>
	ExpiresActive On
	ExpiresByType text/html "access plus 0 seconds"
	ExpiresByType font/woff2 "access plus 1 year"
	ExpiresByType image/webp "access plus 30 days"
	ExpiresByType image/png "access plus 30 days"
	ExpiresByType image/svg+xml "access plus 30 days"
	ExpiresByType image/x-icon "access plus 30 days"
	ExpiresByType application/manifest+json "access plus 1 day"
	ExpiresByType application/xml "access plus 1 day"
	ExpiresByType text/plain "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
	Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
	Header always set Content-Security-Policy "default-src 'none'; script-src 'self' 'sha256-0P24dZF0xB9EUTSKWhRmDiUe0kbCkp15n0CQW0/q/w0=' 'sha256-1DGEibYUvxzIb0eeErDQBSZm63G6vj5O/bVosj9bw5Y=' 'sha256-5Q6IoHZpaExZBf5B1UR/11rVTDahfu2yBrLUbmWK55w=' 'sha256-9s4tz0DJ+5toxUMy2LgzUkzHAhznnTLTYTTnw9tjDaM=' 'sha256-AFYh7E6nmVoVArGeipMGRwep1bgKahcvX0BCSsY9Lko=' 'sha256-D6SS9BezFe18rQJ5QWC8dPqjpQvymhNwc5vMCzJd+zs=' 'sha256-ERogwm3tgxFO+Qzlr8YySaSSUT8JR/C90+5afMzJI7A=' 'sha256-Kq933rTAdOoG65q1GnnKfXc80NQCZo+kDQHi21KUbyA=' 'sha256-OhN+jT7naIAewFZ24Xu00IiiSkmFVH7WVItJhIug5Ss=' 'sha256-Q6qmXpMPdGqwASTnPyDV5D3K7TJD4Ge/zfpBDa2ua64=' 'sha256-QPj+ky8gCDjO+w2dAG+NBTglfQsF4xPanbJJD7IQMq4=' 'sha256-YukDeKkWQQwfZUplIxSrXYzt5wVkr4OIkJ3u/lunGCs=' 'sha256-ZPJ3aAtUsbHUna/6hdVuJOR8zWlf6a4cagw7DTK88qA=' 'sha256-co7LOL9T2qEK6kFfqxitQRPruJ3MnxC0IM39jrNF/mQ=' 'sha256-flDic7sDOAI81tiCzYynFB1my6+cwuFmflfUvfC9xdg=' 'sha256-fxGw3sfb9AOvHMsu1Hz0mScMGb9CVmJV6emqxygHESE=' 'sha256-gphD0UvkCQ/1CsBCeWDvoFCTeBgbNsS48BJkPLQPkiU=' 'sha256-iwNF7mm21wsqcn6jBwOxGiMk5IkuuZGUeI7x+G2jY/0=' 'sha256-kNtGhdV068zmfj+wWLhB/RESAnA2TyEmXuYoiq3q0C8=' 'sha256-km7d9j4LTmstuuYF1hrhHvflWwlINdII3O8sR/JHqas=' 'sha256-maLZdPmzMzStzFq1DQt/N6QSbxvwwSA8Ts3qZVzuCjw=' 'sha256-o/8rdiV3k+2xucLuuGYa20KyXY94OmjOkLuyBSRZDkk=' 'sha256-ozC4mB0hm3+rAiaCsJ299OW2bSy8Qeu1iZ9joW084Go=' 'sha256-wQQm5cLmjRX+YIW6swowEmgth1WHTiZqRd2rVcHZAP0=' 'sha256-xqVvwVBUJlOY3cD5Z35hfeAHQ6sXJ61IV9Tad68NEX4=' 'sha256-y/6VvQDp4kPYhZok7BA7KzwgYUdY/QiSxsvHPzMuvEs=' https://challenges.cloudflare.com https://static.cloudflareinsights.com; script-src-attr 'none'; style-src 'self' 'sha256-3zw0obfHbLpsnkFRKdmdKcl7PyqWg7TgTloiBdAssNM=' 'sha256-JdHjnJMQN/v2BUqg287+m+DIAFJc/zuj3P2i276+o6o=' 'sha256-d6UHteVT5k0HY6DWecoWB7ITcTyNVZoJhmSdZJlBrwo=' 'sha256-l6bAE7zlZA1Wx2lOPYQzjX2hV3VZzvMPjYNOaXcII2I=' 'sha256-qtHggZlaOktUScYQKAaw00VrGFAsB03bR5n5WSsNElA=' 'sha256-uw2aTYZQChK96hxZVUnrH7tJxdHO1nMZmXCfSl+Mdes='; style-src-attr 'none'; img-src 'self' data:; font-src 'self'; manifest-src 'self'; connect-src 'self' https://api.josuecorreaq.com https://challenges.cloudflare.com https://cloudflareinsights.com; frame-src https://challenges.cloudflare.com; form-action 'self' https://api.josuecorreaq.com; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
	Header always set X-Content-Type-Options "nosniff"
	Header always set X-Frame-Options "DENY"
	Header always set Referrer-Policy "strict-origin-when-cross-origin"
	Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

	# HTML: revalidar siempre. Evita servir una versión vieja tras un deploy.
	<FilesMatch "\.html$">
		Header set Cache-Control "no-cache"
	</FilesMatch>
	# Fuentes: nombre y contenido estables, se pueden cachear indefinidamente.
	<FilesMatch "\.woff2$">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</FilesMatch>
	# Imágenes e iconos: el nombre no lleva hash, 30 días para poder reemplazarlos.
	<FilesMatch "\.(webp|png|svg|ico)$">
		Header set Cache-Control "public, max-age=2592000"
	</FilesMatch>
	<FilesMatch "\.(webmanifest|xml|txt)$">
		Header set Cache-Control "public, max-age=86400"
	</FilesMatch>
	# CSS y JS del build: el nombre lleva el hash del contenido y cada deploy apunta a nombres nuevos.
	<If "%{REQUEST_URI} =~ m#^/_astro/#">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</If>
	# Fragmentos que la página carga por fetch (el CV del diálogo): no son páginas propias.
	<If "%{REQUEST_URI} =~ m#^/partials/#">
		Header set X-Robots-Tag "noindex"
	</If>
</IfModule>
